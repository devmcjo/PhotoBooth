# MC포토 웹 클라이언트 빌드 주입값 (01 §4.1)
# 실제 값은 .env.production.local / .env.local 에 두고 커밋하지 않는다.

# 백엔드 API 베이스 URL — 트레일링 슬래시는 코드가 "부여"한다
VITE_BACKEND_BASE_URL=https://asia-northeast3-mcphoto-955fb.cloudfunctions.net/api

# 배포 게이트 키(웹 전용 키 — 브라우저에 공개됨을 전제한다, WD10)
VITE_BACKEND_API_KEY=

# Google OAuth 웹 클라이언트 ID(빈 값이면 로그인 버튼을 숨긴다 — analysis/61 §8)
VITE_GOOGLE_CLIENT_ID=

# 다운로드 페이지(P1) 베이스 URL — 트레일링 슬래시는 코드가 "제거"한다
VITE_HOSTING_BASE_URL=https://mcphoto-955fb.web.app

# Storage 버킷
VITE_STORAGE_BUCKET=mcphoto-955fb.firebasestorage.app

# 버전 표기(화면 하단 캡션 `v{version}`)
VITE_APP_VERSION=0.1.0

# 빌드 시각(진단 화면 전용 — 미지정 시 빌드 순간이 주입된다)
VITE_BUILD_DATE=
