# MC포토 백엔드 프록시 — 로컬 개발/Emulator용 환경변수 템플릿.
# 이 파일은 커밋 대상(실값 없음). 실제 .env 는 .gitignore 로 커밋 차단된다.
#
# 배포 시에는 이 값들을 Google Secret Manager / Functions secrets 로 등록한다
# (firebase functions:secrets:set JWT_SECRET 등). 코드/리포에 하드코딩 금지.

# JWT 서명 시크릿(HS256). 로컬은 임의 문자열, 배포는 강한 랜덤 값.
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# JWT 만료(초). 기본 8시간(키오스크 장시간 로그인 대응, 설계 §7.2).
JWT_EXPIRES_IN_SECONDS=28800

# 배포별 클라이언트 API 키(게스트 가능 엔드포인트 게이트). 쉼표로 여러 개 허용.
# 유출 시 해당 키만 목록에서 제거해 폐기한다(설계 §1.3).
CLIENT_API_KEYS=dev-client-key

# Storage 버킷(서명 URL·토큰 URL 조립용). Emulator/배포 모두 실제 버킷명.
STORAGE_BUCKET=mcphoto-955fb.firebasestorage.app

# 모바일 다운로드 페이지 base URL(downloadPageUrl 조립, firebase-contract §3.5).
HOSTING_BASE_URL=https://mcphoto-955fb.web.app
