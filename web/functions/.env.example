# MCPhoto 백엔드 프록시 — 로컬 개발/Emulator용 환경변수 템플릿.
# 이 파일은 커밋 대상(실값 없음). 실제 .env 는 .gitignore 로 커밋 차단된다.
#
# 배포 시에는 이 값들을 Google Secret Manager / Functions secrets 로 등록한다
# (firebase functions:secrets:set JWT_SECRET 등). 코드/리포에 하드코딩 금지.

# JWT 서명 시크릿(HS256). 로컬은 임의 문자열, 배포는 강한 랜덤 값.
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# JWT 만료(초). 기본 8시간(키오스크 장시간 로그인 대응, 설계 §7.2).
JWT_EXPIRES_IN_SECONDS=28800

# 배포별 클라이언트 API 키(게스트 가능 엔드포인트 게이트). 쉼표로 여러 개 허용.
# 유출 시 해당 키만 목록에서 제거해 폐기한다(설계 §1.3).
CLIENT_API_KEYS=dev-client-key

# Storage 버킷(서명 URL·토큰 URL 조립용). Emulator/배포 모두 실제 버킷명.
STORAGE_BUCKET=mcphoto-955fb.firebasestorage.app

# 모바일 다운로드 페이지 base URL(downloadPageUrl 조립, firebase-contract §3.5).
HOSTING_BASE_URL=https://mcphoto-955fb.web.app

# it15: 이메일 관련 설정(EMAIL_PROVIDER·EMAIL_FROM·SENDGRID_API_KEY)은 폐지됐다.
# 이메일 인증·비밀번호 재설정 기능이 제거되어 서버가 메일을 보내지 않는다.

# ── item1b: Google SSO (운영자 소셜 로그인, 설계 wpf-google-sso-design.md §8.2) ──
# client id·secret이 모두 설정돼야 /auth/google 활성화(둘 다 비우면 비활성 → 501).
# 한쪽만 설정하면 오구성으로 서버가 조기 실패한다.
#
# Google OAuth 클라이언트 ID(비밀 아님 → env/param). Desktop app 유형 클라이언트의 Client ID.
# GOOGLE_OAUTH_CLIENT_ID=<Google Cloud 콘솔에서 발급한 Client ID>
#
# Google OAuth 클라이언트 secret — 절대 커밋 금지. 배포는 Functions secrets 로 주입한다:
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
# code 교환에만 쓰이며 백엔드 전용(클라 WPF 에는 넣지 않는다). 여기에 실값을 넣지 말 것.
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# (선택) 허용 Workspace hosted domain — 설정 시 id_token.hd 가 이 값과 일치해야 로그인 허용(§6.5).
# 미설정이면 hd 제한 없음(등록·검증된 계정 email 매핑 화이트리스트로만 통제).
# GOOGLE_ALLOWED_HD=your-workspace-domain.example
