rules_version = '2';

// MCPhoto Cloud Storage 보안 규칙 — 웹(공개) 관점의 최소 권한.
//
// 웹은 Storage SDK 로 파일을 읽지 않고 문서에 담긴 다운로드 토큰 URL 로 직접 GET 한다.
// 토큰 URL(?alt=media&token=...) 은 그 자체가 capability 이며 보안 규칙을 우회하므로,
// results/ 의 SDK read 를 false 로 닫아도 웹 다운로드는 정상 동작한다.
// 오히려 닫아두는 편이 SDK 경로 열거·직접 접근을 막아 안전하다(계약 §5.2).
//
// 주의: WPF 서비스 계정(Admin SDK)은 규칙을 우회하므로 아래 write:false 가
// WPF 의 파일 업로드를 막지 않는다.
service firebase.storage {
  match /b/{bucket}/o {

    // results/: 결과물(최종 이미지·타임랩스). 웹은 토큰 URL 직접 GET → SDK 경로는 닫음.
    match /results/{sessionId}/{fileName} {
      allow read:  if false;  // SDK 경로 열거·직접 접근 차단 (토큰 URL 은 규칙 우회하여 동작)
      allow write: if false;  // 웹 쓰기 없음
    }

    // frames/: 프레임 이미지 (WPF 전용). 웹 접근 전면 차단.
    // ⚠️ 2026-08-07: 개인 프레임 경로가 frames/users/{userId}/ 로 한 단계 깊어졌다.
    //    {userId}/{fileName} 2단 매치로는 새 경로를 덮지 못하므로 하위 전체를 매치한다
    //    (미매치 시에도 기본 차단이 적용되지만, 의도를 명시적으로 남긴다).
    match /frames/{allPaths=**} {
      allow read, write: if false;
    }

    // 그 외 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
