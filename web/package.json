{
  "name": "mcphoto-web",
  "version": "1.0.0",
  "private": true,
  "description": "MC포토 모바일 다운로드 웹 페이지 (Firebase Hosting)",
  "type": "module",
  "scripts": {
    "serve": "firebase emulators:start --only hosting",
    "emulators": "firebase emulators:start --only firestore,storage,hosting",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node tests/rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0"
  }
}
