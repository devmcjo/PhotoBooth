rules_version = '2';

// MCPhoto Firestore 보안 규칙 — 웹(공개) 관점의 최소 권한.
//
// 웹 Firebase config(apiKey)는 공개되므로 이 규칙이 유일한 방어선이다(PRD §10).
// 계약(firebase-contract.md §5.1) 준수: users/frameTemplates 전면 차단,
// resultSessions 는 단건 get 만 허용(list/write deny).
//
// 주의: WPF 서비스 계정(Admin SDK)은 보안 규칙을 완전히 우회하므로 아래 write:false 가
// WPF 의 문서 생성을 막지 않는다. 배포 시 WPF 를 규칙 준수 인증 클라이언트로 전환하면,
// 그때 인증 계정 write 조건을 별도로 추가한다(웹=비인증에는 여전히 deny).
service cloud.firestore {
  match /databases/{database}/documents {

    // users: 계정 문서 전면 차단 (PIN 해시·역할·이메일 보호 — 노출 시 전체 계정 유출)
    // it15: 비밀번호 필드는 폐지됐다. 남은 민감 필드는 pinHash(설정 진입 게이트)와 role(권한)이며,
    // 계정 조작은 전부 백엔드 API(Bearer + 서버 위계 검증)를 거친다.
    match /users/{uid} {
      allow read, write: if false;
    }

    // frameTemplates: 전면 차단 (웹 접근 없음, WPF 전용)
    match /frameTemplates/{fid} {
      allow read, write: if false;
    }

    // resultSessions: 토큰 ID 단건 get 만 허용.
    // get 과 list 를 분리한다 — allow read(get+list 통합)를 쓰면 list 가 열려
    // 토큰 열거가 가능해지므로 금지한다.
    match /resultSessions/{sid} {
      allow get:   if true;   // 단건 조회 허용 (토큰 = capability)
      allow list:  if false;  // 쿼리/열거 금지 (토큰 열거 방어) — 핵심
      allow write: if false;  // 웹 쓰기 없음 (WPF 가 신뢰 경로로 생성)
    }

    // 그 외 모든 경로 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
