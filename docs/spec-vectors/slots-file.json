{
  "name": "slots-file",
  "spec": "docs/analysis/41 §3.3 (.slots v2 포맷) · design/wpf-frame-ownership-binding-design.md §3",
  "note": "v2 파일 = base64( payload + \"\\n#sig=\" + HMAC_SHA256_hex(key, payload) ). 서명 키는 플랫폼 내장이라 벡터에 담지 않는다 — 이 벡터는 payload 텍스트 규격과 파싱 규칙만 고정한다. 각 클라이언트는 payload를 이 형태로 만들고 자기 키로 서명한 뒤, 읽을 때 서명을 검증하고 같은 규칙으로 파싱해야 한다. 필드 순서(#v → #owner → #imagesize → #dbid → 슬롯)는 서명 대상 바이트를 결정하므로 계약이다.",
  "cases": [
    {
      "name": "공용 프레임(dbId 있음)",
      "content": {
        "owner": "default",
        "imageSize": { "width": 1200, "height": 1600 },
        "dbId": "abc123",
        "slots": [
          { "index": 0, "x": 80, "y": 117, "width": 490, "height": 653 },
          { "index": 1, "x": 630, "y": 117, "width": 490, "height": 653 }
        ]
      },
      "expectedPayload": "#v=2\n#owner=default\n#imagesize=1200,1600\n#dbid=abc123\n0,80,117,490,653\n1,630,117,490,653"
    },
    {
      "name": "개인 프레임(dbId 없음 — 서버 미동기)",
      "content": {
        "owner": "a@google.com",
        "imageSize": { "width": 1000, "height": 1000 },
        "dbId": null,
        "slots": [
          { "index": 0, "x": 0, "y": 0, "width": 100, "height": 100 }
        ]
      },
      "expectedPayload": "#v=2\n#owner=a@google.com\n#imagesize=1000,1000\n0,0,0,100,100"
    },
    {
      "name": "슬롯 6개(상한)",
      "content": {
        "owner": "default",
        "imageSize": { "width": 1200, "height": 1800 },
        "dbId": null,
        "slots": [
          { "index": 0, "x": 0, "y": 0, "width": 10, "height": 10 },
          { "index": 1, "x": 10, "y": 0, "width": 10, "height": 10 },
          { "index": 2, "x": 20, "y": 0, "width": 10, "height": 10 },
          { "index": 3, "x": 0, "y": 10, "width": 10, "height": 10 },
          { "index": 4, "x": 10, "y": 10, "width": 10, "height": 10 },
          { "index": 5, "x": 20, "y": 10, "width": 10, "height": 10 }
        ]
      },
      "expectedPayload": "#v=2\n#owner=default\n#imagesize=1200,1800\n0,0,0,10,10\n1,10,0,10,10\n2,20,0,10,10\n3,0,10,10,10\n4,10,10,10,10\n5,20,10,10,10"
    }
  ],
  "rejectCases": [
    {
      "name": "구 포맷(v1 평문) — base64가 아니므로 거부",
      "fileText": "#imagesize=1200,1600\n0,80,117,490,653\n",
      "expectedStatus": "NotEncoded"
    },
    {
      "name": "빈 파일",
      "fileText": "",
      "expectedStatus": "NotEncoded"
    },
    {
      "name": "base64지만 #sig 줄 없음",
      "fileText": "I3Y9Mgojb3duZXI9ZGVmYXVsdAojaW1hZ2VzaXplPTEsMQowLDAsMCwxLDE=",
      "expectedStatus": "SignatureMissing"
    }
  ]
}
