<Project>
  <!-- 전 프로젝트 공통 빌드 속성 (WBS Step 1) -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 변경 프로젝트 warning 0 원칙(build-verify Step3). 경고를 명시적으로 감시 -->
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 어셈블리 메타데이터 -->
    <Company>MCPhoto</Company>
    <!-- 제품 이름: exe 파일 속성·작업 관리자·AssemblyProduct에 노출된다. 웹 페이지·인스톨러와
         동일하게 "MCPhoto"로 통일(it19 후속 — 종전 "MC포토"). -->
    <Product>MCPhoto</Product>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <!-- ── 버전 (it18) ──
         릴리스 시 여기 Version 한 줄만 올린다. AssemblyVersion/FileVersion은 파생되므로
         exe 리소스(파일 속성 > 자세히의 파일 버전·제품 버전)도 함께 맞춰진다.
         앱이 표기하는 버전은 이 값을 어셈블리에서 읽는다(AssemblyBuildInfoService) — 외부 파일 없음.
         종전 bldinfo.ini 방식은 폐기: 산출물 파일을 따로 교체해야 하고 리소스 버전(1.0.0.0)과
         표기 버전이 어긋나는 이중 관리였다. -->
    <Version>1.1.16</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <!-- 제품 버전(AssemblyInformationalVersion)에 git 커밋 해시가 붙지 않게 한다.
         .NET SDK는 기본적으로 "+{SourceRevisionId}"를 덧붙여 파일 속성의 제품 버전이
         "0.0.0+c4469825f411..."처럼 보인다 — 운영자가 읽는 값이라 해시를 뺀다. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 결정적 빌드 -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
