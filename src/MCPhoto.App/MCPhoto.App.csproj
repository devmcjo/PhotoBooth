<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MCPhoto</AssemblyName>
    <RootNamespace>MCPhoto.App</RootNamespace>

    <!-- 앱 아이콘(exe 리소스로 임베드 → 탐색기·작업표시줄·타이틀바에 모두 반영).
         Window.Icon은 일부러 지정하지 않는다: XAML로 지정하면 WPF가 단일 프레임을 골라
         축소하느라 16px 타이틀바가 흐려진다. 미지정 시 Windows가 exe의 멀티해상도
         리소스(16~256px)에서 용도별 프레임을 정확히 선택한다.
         원본·후보·재생성 방법은 tools/icon-forge/README.md 참조. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCPhoto.Core\MCPhoto.Core.csproj" />
    <ProjectReference Include="..\MCPhoto.Capture\MCPhoto.Capture.csproj" />
    <!-- 백엔드 프록시 HTTP 계층(방향 B). it15부터 레거시 직결 경로가 폐지되어 유일한 서버 경로다. -->
    <ProjectReference Include="..\MCPhoto.Http\MCPhoto.Http.csproj" />
    <!-- it23: 외부 카메라(DSLR) 어댑터. SDK 참조는 이 프로젝트 안에만 생기므로, 라이선스 문제로
         동봉이 불가해지면 이 줄과 DI 등록 한 줄을 되돌려 NullExternalCamera로 복귀한다(설계 §13). -->
    <ProjectReference Include="..\MCPhoto.Devices.Nikon\MCPhoto.Devices.Nikon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceRegistration(합성 루트) 배선 단위 테스트 접근 허용.
         로그아웃 시 JWT 폐기처럼 "어디에도 코드가 없어서 생기는" 결함은 합성 루트를 실제로
         조립해봐야 재현된다 — 개별 클래스 단위 테스트로는 잡히지 않는다. -->
    <InternalsVisibleTo Include="MCPhoto.Tests" />
  </ItemGroup>

  <!-- 백엔드 게이트 키 exe 내장: publish 시 -p:BackendApiKeyDefault=<키>를 주면 AssemblyMetadata로 바이너리에 박힌다.
       키 값은 로컬 backend-apikey.local(gitignore)에서 publish.ps1이 읽어 전달 → git·소스엔 없음. 미지정 시 속성 없음(빈 값). -->
  <ItemGroup Condition="'$(BackendApiKeyDefault)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MCPhoto.BackendApiKey</_Parameter1>
      <_Parameter2>$(BackendApiKeyDefault)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ffmpeg 번들(타임랩스 녹화·변환에 필수). ffprobe는 코드 미사용이라 제외(용량 절약). architecture §1.2 -->
  <PropertyGroup>
    <FfmpegSource>$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffmpeg.exe</FfmpegSource>
  </PropertyGroup>

  <!-- 일반 빌드/실행(bin\...\tools\ffmpeg\)용 복사. 존재할 때만(부재 시 빌드 통과). -->
  <ItemGroup>
    <None Include="$(FfmpegSource)"
          Condition="Exists('$(FfmpegSource)')"
          Link="tools\ffmpeg\ffmpeg.exe"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- publish 최종본에도 확실히 포함. 단일 파일 publish는 내부 임시 빌드에서 위 None 항목의
       Condition이 뒤집혀 누락되므로, publish 완료 후 메인 프로젝트 컨텍스트에서 직접 복사. -->
  <Target Name="CopyFfmpegToPublish" AfterTargets="Publish" Condition="Exists('$(FfmpegSource)')">
    <Copy SourceFiles="$(FfmpegSource)"
          DestinationFiles="$(PublishDir)tools\ffmpeg\ffmpeg.exe"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="ffmpeg 번들 복사 완료 → $(PublishDir)tools\ffmpeg\ffmpeg.exe" />
  </Target>

  <!-- ══════════ 오픈소스 라이선스 고지(licenses/) ══════════
       GPLv3 바이너리(ffmpeg.exe)를 재배포하므로 라이선스 전문·저작권 고지·대응 소스 안내를
       배포물에 반드시 동봉해야 한다(GPLv3 §4·§6). 누락은 라이선스 위반이다.
       설계: docs/design/wpf-ffmpeg-licensing-and-distribution-design.md §5.1 -->
  <PropertyGroup>
    <LicensesSource>$(MSBuildProjectDirectory)\..\..\licenses</LicensesSource>
  </PropertyGroup>

  <PropertyGroup>
    <McPhotoLicenseFile>$(MSBuildProjectDirectory)\..\..\LICENSE</McPhotoLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LicensesSource)\**\*.*"
          Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- MC포토 본체(MIT) 전문도 함께 실어야 licenses/README.txt의 안내가 참이 된다.
         원본은 리포 루트 LICENSE 하나 — 사본을 만들지 않고 링크 복사로 단일 소스를 유지한다. -->
    <None Include="$(McPhotoLicenseFile)"
          Condition="Exists('$(McPhotoLicenseFile)')"
          Link="licenses\MCPhoto-LICENSE-MIT.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- publish 산출물에도 확실히 포함(인스톨러가 publish 폴더 전체를 담는다).
       ffmpeg와 같은 이유로 명시 복사한다 — 라이선스 누락은 법적 문제라 이중 안전을 둔다. -->
  <Target Name="CopyLicensesToPublish" AfterTargets="Publish" Condition="Exists('$(LicensesSource)')">
    <ItemGroup>
      <LicenseFiles Include="$(LicensesSource)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LicenseFiles)"
          DestinationFiles="@(LicenseFiles->'$(PublishDir)licenses\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(McPhotoLicenseFile)"
          DestinationFiles="$(PublishDir)licenses\MCPhoto-LICENSE-MIT.txt"
          Condition="Exists('$(McPhotoLicenseFile)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="라이선스 고지 복사 완료 → $(PublishDir)licenses\" />
  </Target>

  <!-- 번들 기본 프레임(Frame/): 출력 Frame/으로 복사(§9 #11 우선순위 ②) -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\..\..\Frame\**\*.*"
          Link="Frame\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- it9 C3: 브랜딩 샘플. 실행 폴더에 동봉(고객이 branding.ini로 리네임해 앱 이름 변경). -->
  <ItemGroup>
    <None Include="branding.ini.sample" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- it18: bldinfo.ini 동봉 제거. 버전은 어셈블리 버전 리소스(Directory.Build.props의 Version),
       빌드 시각은 exe 타임스탬프에서 읽는다 → 산출물에 동봉할 파일이 없다. -->

</Project>
