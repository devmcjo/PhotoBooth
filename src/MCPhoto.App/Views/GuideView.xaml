<UserControl x:Class="MCPhoto.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}">
        <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="440">
            <StackPanel>
                <TextBlock Text="촬영 안내" Style="{StaticResource Text.H1}"
                           HorizontalAlignment="Center" Margin="0,0,0,28" />

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="촬영 컷 수" Style="{StaticResource Text.Body}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CutCount}" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Accent.Text}" FontWeight="Bold" />
                        <TextBlock Text=" 컷" Style="{StaticResource Text.Body}" />
                        <!-- it17: 자동 모드로 산출된 컷 수임을 알린다(고정 설정이면 미노출). -->
                        <TextBlock Text=" (자동)" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center"
                                   Visibility="{Binding IsAutoCutCount, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="컷당 카운트다운" Style="{StaticResource Text.Body}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CountdownSec}" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Accent.Text}" FontWeight="Bold" />
                        <TextBlock Text=" 초" Style="{StaticResource Text.Body}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="선택할 컷" Style="{StaticResource Text.Body}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SlotCount}" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Accent.Text}" FontWeight="Bold" />
                        <TextBlock Text=" 장" Style="{StaticResource Text.Body}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="촬영 중 [바로 촬영]으로 즉시 셔터를 누를 수 있어요."
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center" Margin="0,16,0,28" TextAlignment="Center" />

                <Button Content="촬영 시작" Command="{Binding StartCaptureCommand}"
                        Style="{StaticResource Button.Primary}" Height="64" FontSize="20"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                <Button Content="취소" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Ghost}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
