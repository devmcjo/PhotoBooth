<UserControl x:Class="MCPhoto.App.Views.UserMgmtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <!--
        사용자 관리(power 전용). 표 밀도를 높인 관리 화면:
          · 정렬은 VM이 담당 — 역할 위계 내림차순 → 같은 역할은 가입 시각 오름차순(최근 가입일수록 아래).
          · 행 좌측 4px 스트립 + 역할 배지 색으로 위계 그룹 경계를 한눈에(RoleBrush 컨버터, 테마 토큰만 참조).
          · 셀 컨트롤은 디자인 시스템 스타일을 BasedOn으로 파생해 높이만 줄인다(38px) — 표 한 행(58px)에 들어가도록.
            키오스크 터치 48px 규칙의 예외: 이 화면은 관리자 전용 마우스 조작 화면이다.
    -->
    <UserControl.Resources>
        <!-- ── 배지(역할·PIN·나) 공통 ── -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Badge.Text" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- PIN 배지: 설정됨=성공(민트), 미설정=주의(앰버). PIN이 유일한 진입 자격증명이라 관리자에게 가시성이 필요하다(it15 §6.5). -->
        <Style x:Key="PinBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="{StaticResource Brush.Success.Surface}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding User.HasPin}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.Warning.Surface}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PinBadge.Text" TargetType="TextBlock" BasedOn="{StaticResource Badge.Text}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding User.HasPin}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 셀 컨트롤(표 밀도용 파생) ── -->
        <Style x:Key="Cell.Combo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Cell.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Cell.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Cell.Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- ── 스크롤바: 기본 Aero(화살표 버튼+회색 트랙) 대신 얇은 pill 썸만 ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <!-- 화살표 버튼은 두지 않고, 페이지 스크롤용 투명 RepeatButton만 남긴다(동작 보존). -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Th" Width="6" CornerRadius="3"
                                                        Background="{StaticResource Brush.Text.Muted}" Opacity="0.45" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Th" Property="Opacity" Value="0.75" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 표 헤더: 기본 Aero 헤더(그라데이션+그리퍼) 제거 → 하단 구분선 1px만 ── -->
        <Style x:Key="Table.Header" TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <!-- Padding 12는 셀 컨텐츠 Margin 12와 짝 — 헤더/셀 좌측 정렬을 맞춘다. -->
                        <Border Background="Transparent" Padding="12,0"
                                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 표 행: 좌측 위계 스트립 + hover + 하단 구분선. 선택 하이라이트는 없음(선택 개념 없는 목록). ── -->
        <Style x:Key="Table.Row" TargetType="ListViewItem">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                      Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                <!-- 위계 스트립은 셀 위에 겹쳐 그린다(별도 컬럼을 두면 헤더와 4px 어긋난다). -->
                                <Border Width="4" HorizontalAlignment="Left" Margin="0,9,0,10" CornerRadius="2"
                                        Background="{Binding User.Role, Converter={StaticResource RoleBrush}, ConverterParameter=Strip}"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 하단 여백 40: 셸(MainWindow)이 우하단에 상시 그리는 버전·배포사이트 표기(하단 10 + 캡션 13pt ≈ 28px)를
         우측 정렬된 "뒤로" 버튼이 침범하지 않도록 비워 둔다. -->
    <Grid Background="{StaticResource Brush.Bg}" Margin="40,80,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ 헤더: 제목 + 인원 요약/정렬 규칙 + 새로고침 ══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="사용자 관리" Style="{StaticResource Text.H1}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="역할이 높은 계정이 위 · 같은 역할은 먼저 가입한 계정이 위"
                               Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="↻ 새로고침" Style="{StaticResource Cell.Button.Ghost}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    AutomationProperties.Name="목록 새로고침" />
        </Grid>

        <!-- ══════════ 목록 ══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"
                Background="{StaticResource Brush.Bg}">
            <Grid>
                <!-- it13 §9.5: 행 DataContext = UserRowViewModel(계정 + 역할 변경 상태). Id/Role은 User 경로로 접근. -->
                <ListView ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Brush.Text.Primary}"
                          ItemContainerStyle="{StaticResource Table.Row}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource Table.Header}"
                                  AllowsColumnReorder="False">
                            <!-- 계정: 아이디(주) + 이메일(보조). 자기 계정은 "나" 배지로 오조작 방지. -->
                            <GridViewColumn Header="계정" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding User.Id}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                        Padding="8,2"
                                                        Background="{StaticResource Brush.Accent.Soft}"
                                                        Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="나" Style="{StaticResource Badge.Text}" FontSize="12"
                                                               Foreground="{StaticResource Brush.Accent.Text}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding EmailText}" Style="{StaticResource Text.Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 역할: 위계 색 배지(한글 라벨). ▼ = 이 열이 1차 내림차순 정렬 기준. -->
                            <GridViewColumn Header="역할 ▼" Width="128">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Margin="12,0,0,0"
                                                Background="{Binding User.Role, Converter={StaticResource RoleBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding User.Role, Converter={StaticResource RoleBrush}, ConverterParameter=Fg}" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 가입 일시: 날짜(주) + 시각(보조), 로컬 시간. ▲ = 2차 오름차순 정렬 기준. -->
                            <GridViewColumn Header="가입 일시 ▲" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedDateText}" FontSize="14"
                                                       Foreground="{StaticResource Brush.Text.Primary}" />
                                            <TextBlock Text="{Binding CreatedTimeText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- it15 §6.5: PIN이 유일한 진입 자격증명이 되어 설정 여부 가시성이 필요하다. -->
                            <GridViewColumn Header="PIN" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PinBadge}" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding PinStateLabel}" Style="{StaticResource PinBadge.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- it13 §9.5: 역할 변경 = 콤보(AssignableRoles 필터) + 적용. CanChangeRole일 때만 노출(빈 목록·자기 계정은 "—"). -->
                            <GridViewColumn Header="역할 변경" Width="232">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding CanChangeRole, Converter={StaticResource BoolToVis}}">
                                                <ComboBox Width="122" Style="{StaticResource Cell.Combo}"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding AssignableRoles}"
                                                          SelectedItem="{Binding SelectedRole}"
                                                          AutomationProperties.Name="지정할 역할">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource RoleLabel}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <!-- Ghost(아웃라인)는 흰 배경 표에서 테두리가 묻혀 버튼으로 안 읽힌다 → 채움 Secondary. -->
                                                <Button Content="적용" Style="{StaticResource Cell.Button.Secondary}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.ApplyRoleChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Text="—" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                                       Visibility="{Binding CanChangeRole, Converter={StaticResource InverseBoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="작업" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 관리 액션은 행위자와 같거나 낮은 역할에만 노출(예: manager는 admin 행에 미노출).
                                             삭제는 오른쪽 끝에 배치 — 옆 버튼과 오조작으로 뒤바뀌지 않게. -->
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <!-- it14/it15: PIN 재설정(CanResetPin — power + 자기보다 낮은 위계 + 타 계정만 노출.
                                                 동급은 미노출 → 매니저 행의 PIN 재설정은 관리자에게만 보인다). 소형 PIN 다이얼로그로 새 PIN 입력. -->
                                            <Button Content="PIN 재설정" Style="{StaticResource Cell.Button.Secondary}" Margin="0,0,8,0"
                                                    Visibility="{Binding CanResetPin, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ResetUserPinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="삭제" Style="{StaticResource Cell.Button.Danger}"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Visibility>
                                                    <!-- 3번째 값(IsSelf)로 자기 계정 행에서는 숨긴다 — 명령이 어차피 거부하는 버튼을 노출하지 않는다. -->
                                                    <MultiBinding Converter="{StaticResource RoleActionVis}" ConverterParameter="Manage">
                                                        <Binding Path="DataContext.ActorRole" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        <Binding Path="User.Role" />
                                                        <Binding Path="IsSelf" />
                                                    </MultiBinding>
                                                </Button.Visibility>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 빈 상태(목록 조회 실패 포함): 표 대신 안내. -->
                <TextBlock Text="표시할 계정이 없습니다." Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Muted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- ══════════ 하단: 상태 메시지 + 뒤로 ══════════ -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToNoticeBrush}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
            <Button Grid.Column="1" Content="뒤로" Command="{Binding BackCommand}"
                    Style="{StaticResource Button.Secondary}" />
        </Grid>
    </Grid>
</UserControl>
