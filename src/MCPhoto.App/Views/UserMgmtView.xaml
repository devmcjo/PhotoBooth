<UserControl x:Class="MCPhoto.App.Views.UserMgmtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}" Margin="40,88,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="사용자 관리" Style="{StaticResource Text.H1}" Margin="0,0,0,16" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <!-- it13 §9.5: 행 DataContext = UserRowViewModel(계정 + 역할 변경 상태). Id/Role은 User 경로로 접근. -->
            <ListView ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource Brush.Text.Primary}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="아이디" Width="200" DisplayMemberBinding="{Binding User.Id}" />
                        <!-- it13 §9.5: 역할 한글 라벨(임시 유저 포함). DisplayMemberBinding은 컨버터 불가 → CellTemplate. -->
                        <GridViewColumn Header="역할" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding User.Role, Converter={StaticResource RoleLabel}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- it13 §9.5: 역할 변경 = 콤보(AssignableRoles 필터) + Apply. CanChangeRole일 때만 노출(빈 목록·자기 계정 미노출). -->
                        <GridViewColumn Header="역할 변경" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding CanChangeRole, Converter={StaticResource BoolToVis}}">
                                        <ComboBox Width="120" VerticalAlignment="Center"
                                                  ItemsSource="{Binding AssignableRoles}"
                                                  SelectedItem="{Binding SelectedRole}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource RoleLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="변경" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" MinWidth="0" Padding="16,0"
                                                Command="{Binding DataContext.ApplyRoleChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="작업" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 관리 액션은 행위자와 같거나 낮은 역할에만 노출(예: manager는 admin 행에 미노출). -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="삭제" Style="{StaticResource Button.Danger}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource RoleActionVis}" ConverterParameter="Manage">
                                                    <Binding Path="DataContext.ActorRole" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding Path="User.Role" />
                                                </MultiBinding>
                                            </Button.Visibility>
                                        </Button>
                                        <Button Content="pw 초기화" Style="{StaticResource Button.Secondary}" MinWidth="0" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ResetUserPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource RoleActionVis}" ConverterParameter="Manage">
                                                    <Binding Path="DataContext.ActorRole" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding Path="User.Role" />
                                                </MultiBinding>
                                            </Button.Visibility>
                                        </Button>
                                        <!-- it14: PIN 재설정(백엔드 + CanManage + 타 계정에서만 노출). 소형 PIN 다이얼로그로 새 PIN 입력. -->
                                        <Button Content="PIN 재설정" Style="{StaticResource Button.Secondary}" MinWidth="0"
                                                Visibility="{Binding CanResetPin, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.ResetUserPinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Success}"
                       Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <Button Content="뒤로" Command="{Binding BackCommand}" Style="{StaticResource Button.Secondary}" />
        </StackPanel>
    </Grid>
</UserControl>
