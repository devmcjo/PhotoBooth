<UserControl x:Class="MCPhoto.App.Views.PasswordResetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded">
    <Grid Background="{StaticResource Brush.Bg}">
        <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="비밀번호 찾기" Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="가입한 아이디 또는 이메일로 인증 코드를 받아 비밀번호를 재설정합니다"
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,28" />

                <!-- ══════════ 1단계: 재설정 요청 ══════════ -->
                <StackPanel Visibility="{Binding IsRequestStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="아이디 또는 이메일" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <TextBox x:Name="IdOrEmailTextBox" Text="{Binding IdOrEmail, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                    <TextBlock Text="{Binding Message}"
                               Foreground="{Binding MessageIsError, Converter={StaticResource BoolToNoticeBrush}}"
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <Button Content="인증 코드 받기" Style="{StaticResource Button.Primary}" IsDefault="True"
                            Command="{Binding RequestResetCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                </StackPanel>

                <!-- ══════════ 2단계: 코드 + 새 비밀번호 ══════════ -->
                <StackPanel Visibility="{Binding IsConfirmStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="인증 코드 (6자리)" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,0,0,16" />

                    <TextBlock Text="새 비밀번호" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="NewPwBox" Margin="0,0,0,12" PasswordChanged="OnNewPasswordChanged" />

                    <TextBlock Text="새 비밀번호 확인" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="ConfirmPwBox" Margin="0,0,0,12" PasswordChanged="OnConfirmPasswordChanged" />

                    <TextBlock Text="{Binding Message}"
                               Foreground="{Binding MessageIsError, Converter={StaticResource BoolToNoticeBrush}}"
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <Button Content="비밀번호 재설정" Style="{StaticResource Button.Primary}" IsDefault="True"
                            Command="{Binding ConfirmResetCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                </StackPanel>

                <Button Content="취소" Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
