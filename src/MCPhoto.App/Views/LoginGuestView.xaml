<UserControl x:Class="MCPhoto.App.Views.LoginGuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="#141018">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <TextBlock Text="로그인 또는 게스트" Foreground="#F5F0FA" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,32" />

            <TextBlock Text="아이디" Foreground="#B9A7D0" FontSize="14" Margin="0,0,0,4" />
            <TextBox Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="20" Padding="10" Margin="0,0,0,16" />

            <TextBlock Text="비밀번호" Foreground="#B9A7D0" FontSize="14" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordInput" FontSize="20" Padding="10" Margin="0,0,0,8"
                         PasswordChanged="OnPasswordChanged" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF7B7B" FontSize="14"
                       Margin="0,0,0,12" TextWrapping="Wrap" />

            <Button Content="로그인" Command="{Binding LoginCommand}"
                    FontSize="20" Padding="0,14" Background="#C44B9B" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" />
            <Button Content="게스트로 계속" Command="{Binding ContinueAsGuestCommand}"
                    FontSize="18" Padding="0,12" Background="#332B3E" Foreground="#E8DEF2"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,24" />
            <Button Content="취소" Command="{Binding CancelCommand}"
                    FontSize="15" Background="Transparent" Foreground="#8574A0"
                    BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
