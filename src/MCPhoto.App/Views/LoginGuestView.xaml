<UserControl x:Class="MCPhoto.App.Views.LoginGuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}">
        <Border Style="{StaticResource Card}" MaxWidth="440" Width="440"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="로그인" Style="{StaticResource Text.H1}"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- 게스트 안내: 로그인은 커스텀 프레임용이며 촬영 자체는 로그인 불요(it15 §6.1). -->
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"
                           Text="촬영은 로그인 없이도 가능합니다.&#10;로그인하면 나만의 프레임을 쓸 수 있어요." />

                <!-- Google 단독 CTA. GoogleClientId 미설정(SSO opt-out) 시 통째로 숨긴다. -->
                <StackPanel Visibility="{Binding IsGoogleSignInAvailable, Converter={StaticResource BoolToVis}}">
                    <Button Content="Google로 로그인" Style="{StaticResource Button.Primary}"
                            Command="{Binding LoginWithGoogleCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <TextBlock Text="로그인 중..." Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- 미구성 안내. [닫기]는 아래에 항상 노출되므로 게스트 촬영 복귀는 보장된다. -->
                <TextBlock Text="로그인이 구성되지 않았습니다. 관리자에게 문의하세요."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"
                           Visibility="{Binding IsGoogleSignInAvailable, Converter={StaticResource InverseBoolToVis}}" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12" />

                <Button Content="닫기" Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
