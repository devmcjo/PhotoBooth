<UserControl x:Class="MCPhoto.App.Views.LoginGuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}">
        <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="로그인" Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="커스텀 프레임·계정 기능을 사용하려면 로그인하세요"
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,0,0,28" />

                <TextBlock Text="아이디" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                <TextBox Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="비밀번호" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,8"
                             PasswordChanged="OnPasswordChanged" KeyDown="OnPasswordKeyDown" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                           Style="{StaticResource Text.Caption}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <Button Content="로그인" Style="{StaticResource Button.Primary}" IsDefault="True"
                        Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                <Button Content="취소" Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
