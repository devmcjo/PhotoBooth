<UserControl x:Class="MCPhoto.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1280">
    <UserControl.Resources>
        <!-- 인라인 행 라벨: 고정폭 제거(잘림 방지, it5 §6 U7). 내용 폭 Auto + 잘림 없음, 우측 여백만. -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <!-- 설정 행: 라벨(Auto) | 컨트롤(*). 라벨이 내용만큼 차지해 잘리지 않음. PC 밀도 Space.S. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- 전폭 입력 행(경로·URL 등 긴 입력) -->
        <Style x:Key="FullRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- 그룹 소제목 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <!-- 그룹 구분선 -->
        <Style x:Key="GroupDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Brush.Divider}" />
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <!-- it12(개정): 게스트 미지원 옵션 인라인 노티. hover 툴팁은 시인성이 낮아 폐지 →
             게이트 토글 좌측에 "로그인 필요" 캡션을 상시 노출(게스트일 때만, 로그인 시 Collapsed). -->
        <Style x:Key="GuestGateNote" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Text" Value="로그인 필요" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGuest}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- it13 §7.3: TempUser QR 한도 초과 사유 문구(경고 톤). 초과 시에만 노출(HasQrLimitNotice), Text는 VM QrLimitNotice 바인딩. -->
        <Style x:Key="QrLimitNote" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasQrLimitNotice}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="40,88,40,16">
            <!-- PC 밀도: 넓은 카드(MaxWidth 1200 — 가로 활용). Stretch로 폭 고정(내용 수축 방지):
                 게스트/로그인·토글 상태에 따라 보이는 행이 달라도 카드 폭·문구 위치가 흔들리지 않게. -->
            <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

                <TextBlock Text="설정" Style="{StaticResource ScreenTitle}" />

                <!-- ══════════ [앱 설정] 섹션 (게스트 포함) ══════════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="앱 설정" Style="{StaticResource Text.H2}" Margin="0,0,0,16" />

                        <!-- 2열 그리드: 촬영|장치·표시. 좁은 폭에선 1열 폴백(code-behind, it5 §6 R6). -->
                        <Grid x:Name="TwoColArea" SizeChanged="OnTwoColSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ── 좌열: 촬영 ── -->
                            <StackPanel x:Name="LeftCol" Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="촬영" Style="{StaticResource GroupTitle}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="촬영 컷 수" Style="{StaticResource RowLabel}" />
                                    <!-- it17: "자동"(값 0) 항목이 생겨 값·라벨을 분리한다. SelectedItem은 record 인스턴스
                                         동일성에 의존해 로드 시 선택 복원이 어긋날 수 있으므로 SelectedValue를 쓴다(설계 §6.1). -->
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="140"
                                              ItemsSource="{Binding CutCountOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding CutCount}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="컷당 카운트다운(초)" Style="{StaticResource RowLabel}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="140"
                                              ItemsSource="{Binding CountdownOptions}" SelectedItem="{Binding CountdownSec}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="거울모드(좌우반전)" Style="{StaticResource RowLabel}" />
                                    <!-- it12 R1: 로그인 전용 편집(게이트). 게스트엔 좌측 "로그인 필요" 노티 상시 노출(개정). -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource GuestGateNote}" />
                                        <ToggleButton Style="{StaticResource Toggle}"
                                                      IsChecked="{Binding MirrorMode}" IsEnabled="{Binding IsLoggedIn}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="플래시" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="{Binding FlashMode}" />
                                </Grid>
                                <!-- 기능#7: 셔터음(플래시 아래). Assets\shutter.wav 있으면 재생, 없으면 시스템음 -->
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="셔터음" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="{Binding ShutterSound}" />
                                </Grid>
                                <!-- it11 #13: 재촬영 사용(상위 토글). on일 때만 하위(횟수 제한) 노출. 컷별 재촬영은 후속. -->
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="재촬영 사용" Style="{StaticResource RowLabel}" />
                                    <!-- it12 R1: 로그인 전용 편집(게이트). 게스트엔 좌측 "로그인 필요" 노티 상시 노출(개정). -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource GuestGateNote}" />
                                        <ToggleButton Style="{StaticResource Toggle}"
                                                      IsChecked="{Binding RetakeEnabled}" IsEnabled="{Binding IsLoggedIn}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 재촬영 하위(횟수 제한): 재촬영 on일 때만 노출. 들여쓰기로 하위 계층 표현(QR 하위 패턴 재사용). -->
                                <StackPanel Margin="20,0,0,0"
                                            Visibility="{Binding RetakeEnabled, Converter={StaticResource BoolToVis}}">
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="↳ 재촬영 횟수 제한" Style="{StaticResource RowLabel}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="140"
                                                  ItemsSource="{Binding RetakeLimitOptions}" SelectedItem="{Binding RetakeLimit}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- 열 간격 -->
                            <Border x:Name="ColGap" Grid.Column="1" Width="{StaticResource Space.XL}" />

                            <!-- ── 우열: 장치·표시 (좁은 폭에선 code-behind가 Column0/Row1로 재배치) ── -->
                            <StackPanel x:Name="RightCol" Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="장치·표시" Style="{StaticResource GroupTitle}" />
                                <!-- it9 C1: 카메라 선택 ComboBox + 테스트/다시검색. 목록 비면 Disable + 안내. -->
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="카메라 장치" Style="{StaticResource RowLabel}" />
                                    <!-- 콤보는 남는 폭을 채우고(*), ↻·테스트는 컴팩트(Auto). (it9 후속 조정) -->
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" VerticalAlignment="Center" MinWidth="200"
                                                  ItemsSource="{Binding CameraDevices}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Index"
                                                  SelectedValue="{Binding CameraDevice}"
                                                  IsEnabled="{Binding HasCamera}" />
                                        <Button Grid.Column="1" Content="↻" ToolTip="카메라 다시 검색"
                                                Style="{StaticResource Button.Secondary}" MinWidth="0" Width="44" Padding="0"
                                                Margin="8,0,0,0" Command="{Binding RefreshCamerasCommand}"
                                                IsEnabled="{Binding IsEnumeratingCameras, Converter={StaticResource InverseBool}}" />
                                        <!-- it23: 웹캠이 0대여도 외부 카메라가 켜져 있으면 테스트할 대상이 있다
                                             (모달 목록에 외부 항목이 오른다) → HasCamera 단독 게이트를 확장. -->
                                        <Button Grid.Column="2" Content="테스트"
                                                Style="{StaticResource Button.Secondary}" MinWidth="0" Padding="16,0"
                                                Margin="8,0,0,0" Command="{Binding OpenCameraTestCommand}"
                                                IsEnabled="{Binding CanOpenCameraTest}" />
                                    </Grid>
                                </Grid>
                                <!-- 카메라 없음 안내. 고정 높이를 항상 예약해 열거 전/후 레이아웃 점프(재배치) 방지. (it9 후속)
                                     안내가 숨겨져도 이 높이는 유지되므로 아래 항목이 위로 밀리지 않음. -->
                                <Grid Height="22" Margin="0,2,0,6">
                                    <TextBlock Text="연결된 카메라가 없습니다. ↻ 다시 검색을 눌러 주세요."
                                               Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Visibility="{Binding HasCamera, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="표시 모드" Style="{StaticResource RowLabel}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="220"
                                              ItemsSource="{Binding DisplayModeOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DisplayMode}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource GroupDivider}" />

                        <!-- ── 출력·전송 | 필터 2열(PC 가로 활용, 세로 길이 축소). 상단 블록과 동일한 *|Auto(gap)|* 패턴 ── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 좌: 출력·전송 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="출력·전송" Style="{StaticResource GroupTitle}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="출력 포맷" Style="{StaticResource RowLabel}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="140"
                                              ItemsSource="{Binding OutputFormatOptions}" SelectedItem="{Binding OutputFormat}" />
                                </Grid>
                                <!-- it12 R2: QR 전송(+하위)·로컬 저장을 장치·표시 → 출력·전송으로 이동. 바인딩 경로 불변(위치만). -->
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="QR 전송" Style="{StaticResource RowLabel}" />
                                    <!-- 게스트는 QR/Firebase 비활성(수정 불가). 로그인 시에만 편집. 게스트엔 "로그인 필요" 노티(개정).
                                         it13 §7.3: TempUser 한도 초과 시에도 disabled(CanEditQr) — 게스트와 별개로 사유 문구(QrLimitNote) 노출. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource GuestGateNote}" />
                                        <TextBlock Style="{StaticResource QrLimitNote}" Text="{Binding QrLimitNotice}" />
                                        <ToggleButton Style="{StaticResource Toggle}"
                                                      IsChecked="{Binding EnableQrDelivery}" IsEnabled="{Binding CanEditQr}" />
                                    </StackPanel>
                                </Grid>
                                <!-- QR 하위 항목(사진/타임랩스 전송·보관 시간): QR on일 때만 노출. 들여쓰기로 하위 계층 표현. (it7 F2) -->
                                <StackPanel Margin="20,0,0,0"
                                            Visibility="{Binding EnableQrDelivery, Converter={StaticResource BoolToVis}}">
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="↳ 사진 전송" Style="{StaticResource RowLabel}" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="{Binding SendPhoto}" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="↳ 타임랩스 전송" Style="{StaticResource RowLabel}" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="{Binding SendTimelapse}" />
                                    </Grid>
                                    <!-- 보관 시간은 QR 다운로드 페이지의 유효 기간이므로 QR 전송 하위로 배치. 바인딩 경로 불변(위치만). -->
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="↳ 보관 시간(1~72h)" Style="{StaticResource RowLabel}" />
                                        <TextBox Grid.Column="1" HorizontalAlignment="Right" Width="140" Text="{Binding RetentionHours}" />
                                    </Grid>
                                </StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="로컬 저장" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="{Binding SaveLocalCopy}" />
                                </Grid>
                                <StackPanel Style="{StaticResource FullRow}">
                                    <TextBlock Text="로컬 저장 경로" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding LocalSavePath}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 열 간격 -->
                            <Border Grid.Column="1" Width="{StaticResource Space.XL}" />

                            <!-- 우: 필터 (it8 §6 A6) — 원본은 항상 제공(토글 불가), 나머지 개별 on/off -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="필터" Style="{StaticResource GroupTitle}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="원본(항상 제공)" Style="{StaticResource RowLabel}" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Toggle}" HorizontalAlignment="Right"
                                                  IsChecked="True" IsEnabled="False" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="흑백" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource GuestGateNote}" />
                                        <ToggleButton Style="{StaticResource Toggle}"
                                                      IsChecked="{Binding FilterGrayscale}" IsEnabled="{Binding IsLoggedIn}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="밝게" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource GuestGateNote}" />
                                        <ToggleButton Style="{StaticResource Toggle}"
                                                      IsChecked="{Binding FilterBrightness}" IsEnabled="{Binding IsLoggedIn}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="뷰티" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource GuestGateNote}" />
                                        <ToggleButton Style="{StaticResource Toggle}"
                                                      IsChecked="{Binding FilterBeauty}" IsEnabled="{Binding IsLoggedIn}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- it23: 외부 장치. 로그인 전용 노출(게스트는 섹션 자체 Collapsed — 현행 유지).
                             ⚠️ 편집 게이트는 CanEditExternalCamera(User 이상 · TempUser 제외)다. TempUser에게는
                                섹션이 **보이되 읽기 전용**이므로 값을 강제 off 하지 않는다(§9.2).
                             ⚠️ 프린터는 여전히 placeholder(범위 밖) — "추후 지원 예정" 유지. -->
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource GroupDivider}" />
                            <TextBlock Text="외부 장치" Style="{StaticResource GroupTitle}" />

                            <!-- W1: 역할 분리 고지(외부 카메라 on일 때만). 타임랩스는 항상 웹캠 전담이다. -->
                            <TextBlock Text="타임랩스 기능은 웹캠으로만 동작됩니다."
                                       Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding ExternalCameraEnabled, Converter={StaticResource BoolToVis}}" />

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="외부 카메라 사용" Style="{StaticResource RowLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- 편집 불가(TempUser) 사유 캡션. 게스트는 섹션 자체가 안 보이므로 이 문구는 TempUser 전용이다. -->
                                    <TextBlock Text="권한 없음" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Visibility="{Binding CanEditExternalCamera, Converter={StaticResource InverseBoolToVis}}" />
                                    <ToggleButton Style="{StaticResource Toggle}"
                                                  IsChecked="{Binding ExternalCameraEnabled}"
                                                  IsEnabled="{Binding CanEditExternalCamera}" />
                                </StackPanel>
                            </Grid>

                            <!-- 하위 설정(모델·노출)은 토글 on일 때만 노출 -->
                            <StackPanel Visibility="{Binding ExternalCameraEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="모델" Style="{StaticResource RowLabel}" />
                                    <!-- ⚠️ SelectedIndex 금지, 값 기반 SelectedValue(it7 B9 사고 이력):
                                         인덱스 바인딩은 목록이 채워지는 순간 저장값을 0으로 덮어쓴다. -->
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="220"
                                              ItemsSource="{Binding ExternalCameraModelOptions}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                              SelectedValue="{Binding ExternalCameraModel}"
                                              IsEnabled="{Binding CanEditExternalCamera}" />
                                </Grid>

                                <!-- W2: 제거 불가능한 광학 불일치 고지. 숨기면 WYSIWYG 사기가 된다(§5.4). -->
                                <TextBlock Text="프리뷰는 웹캠 영상입니다. 실제 사진은 외부 카메라로 촬영되어 구도·화각이 프리뷰와 다를 수 있습니다."
                                           Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />

                                <!-- 노출 3요소: 슬라이더(도메인 인덱스) + 직접 입력 병행(요구 5).
                                     ⚠️ 편집 게이트를 ItemsControl에 건다(§8.3-3): 행 내부 컨트롤의 DataContext는
                                        ExposureParameterViewModel이라 CanEditExternalCamera가 해석되지 않는다.
                                        부모가 Disable이면 자식은 어떤 값이어도 활성화될 수 없으므로 이 한 지점으로
                                        3행 전체가 읽기 전용이 된다.
                                     ⚠️ 이 게이트가 없으면 TempUser가 값을 고쳐 [저장]을 누를 수 있고, 저장은
                                        미기록(원값 보존)이므로 "저장되었습니다" 직후 입력이 조용히 되돌아간다
                                        — 성공 오인이다. -->
                                <ItemsControl ItemsSource="{Binding ExposureParameters}"
                                              IsEnabled="{Binding CanEditExternalCamera}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 라벨은 고정폭을 주지 않는다(잘림 방지 관례 — RowLabel과 동일 규칙). -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Style="{StaticResource RowLabel}" />
                                                    <!-- 값 = 도메인 인덱스. 눈금 스냅으로 목록 밖 값이 만들어지지 않는다.
                                                         도메인 미확보(미연결)면 Disable — 조작할 목록이 없다(§10.3). -->
                                                    <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                            Minimum="0" Maximum="{Binding MaxIndex}"
                                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                                            Value="{Binding SelectedIndex}"
                                                            IsEnabled="{Binding IsDomainAvailable}" />
                                                    <!-- 직접 입력은 도메인 미확보 상태에서도 활성(운영자가 장비 없이 미리 준비). -->
                                                    <TextBox Grid.Column="2" Width="120" VerticalAlignment="Center"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}"
                                                           Foreground="{StaticResource Brush.Warning}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- W3: 도메인 미확보 안내. 설정 진입은 USB 장치를 건드리지 않으므로(§9.1)
                                     목록은 촬영 세션·테스트 모달에서 연결된 뒤에 채워진다. -->
                                <TextBlock Text="노출 목록은 카메라 연결 시 확인됩니다."
                                           Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding HasExposureDomain, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="프린터 사용" Style="{StaticResource RowLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="추후 지원 예정" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ToggleButton Style="{StaticResource Toggle}"
                                                  IsChecked="{Binding PhotoPrinterEnabled}" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource GroupDivider}" />

                        <!-- ── 그룹: 고급 ── -->
                        <!-- W-5: HostingBaseUrl·StorageBucket 편집 UI 제거(ini 전용 유지, VM 라운드트립으로 값 보존).
                             서버 연결 상태·진단 항목이 이 그룹에 남아 있어 그룹 제목·Divider는 유지. -->
                        <TextBlock Text="고급" Style="{StaticResource GroupTitle}" />

                        <!-- it10 S4-2: 서버 연결 상태(읽기 전용, 표시 전용 — 저장 대상 아님). QA 트러블슈팅용. -->
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="서버 연결" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding ServerStatusText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <!-- 연결=성공(민트) / 미연결=danger(로즈). 신규 리소스 키 없이 기존 팔레트 브러시만 사용. -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- it23 C부: 오픈소스 라이선스 전문 열람(같은 화면 위 오버레이).
                             ⚠️ IsEnabled 바인딩을 **붙이지 않는다** — GPLv3 §4는 전문을 수령자에게 전달할 것을
                                요구하므로 고지 접근은 로그인·역할과 무관해야 한다(게스트 포함, 수락 기준 AC-C1).
                             [진단·상태] **위**에 두는 이유: 진단은 로그인 전용이고 라이선스는 전원 접근이므로
                             접근 범위가 넓은 항목을 먼저 둔다. -->
                        <Button Content="오픈소스 라이선스" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left" MinWidth="0" Padding="20,0" Margin="0,4,0,0"
                                Command="{Binding OpenLicenseViewerCommand}" />

                        <!-- it11 #14: 진단·상태 모달 진입. 로그인 상태에서만 활성(게스트 Disable). 관리자 트러블슈팅용. -->
                        <Button Content="진단·상태" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left" MinWidth="0" Padding="20,0" Margin="0,4,0,0"
                                Command="{Binding OpenDiagnosticsCommand}" IsEnabled="{Binding IsLoggedIn}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- A4: sticky 하단 고정 바(ScrollViewer 밖). 저장/닫기 항상 노출 + 저장 토스트. (it8 §5.1) -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Bg}" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Brush.Divider}" Effect="{StaticResource Shadow.Sm}"
                Padding="40,12">
            <!-- 저장/닫기만. 저장 안내는 상단 토스트로 분리(버튼 가림 방지).
                 프레임선택(다음/취소)과 동일하게 중앙 배치 + 각 Margin 8,0(→ 버튼 간 16px 간격). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="저장" Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveSettingsCommand}" Margin="8,0" />
                <Button Content="닫기" Style="{StaticResource Button.Ghost}"
                        Command="{Binding CloseCommand}" Margin="8,0" />
            </StackPanel>
        </Border>

        <!-- 저장 결과 토스트: 상단 중앙, 자동 숨김(3~6초). 하단 버튼과 분리해 가림 방지. 클릭 비간섭. -->
        <Border Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0"
                IsHitTestVisible="False"
                Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Pill}"
                Padding="24,12" Effect="{StaticResource Shadow.Pop}"
                Visibility="{Binding HasSavedNotice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SavedNotice}" Style="{StaticResource Text.Body}"
                       Foreground="{Binding SavedNoticeIsError, Converter={StaticResource BoolToNoticeBrush}}" />
        </Border>

        <!-- ══════════ 오픈소스 라이선스 뷰어 오버레이 (it23 C부, 설계 §C3.1) ══════════
             왜 오버레이인가: 35 KB 전문을 설정 화면의 ScrollViewer 안에 인라인으로 넣으면 **중첩 스크롤**이
             되어 조작이 불가능해진다(내부 TextBox가 무한 높이를 요구). 새 Window로 만들지 않는 이유는
             headless 테스트에서 Window를 인스턴스화할 수 없어 XAML 회귀를 잡을 수 없기 때문이다.
             ⚠️ Grid.RowSpan="2" — sticky 저장/닫기 바까지 덮어야 모달이 된다(저장 토스트와 같은 기법).
             ⚠️ 이 화면 배경은 흰색(Brush.Bg)이다. 스크림 위에 **불투명 Card + 기본 글자색**을 쓴다 —
                CaptureView의 스크림+흰 글자 조합을 복사하면 글자가 읽히지 않는다.
             ⚠️ 신규 리소스 키 0개(병합 딕셔너리 교차 참조 함정 회피). -->
        <Grid Grid.RowSpan="2" Background="{StaticResource Brush.Scrim}"
              Visibility="{Binding IsLicenseViewerOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Background="{StaticResource Brush.Bg}"
                    Effect="{StaticResource Shadow.Pop}" MaxWidth="1000" Margin="40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 헤더 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="오픈소스 라이선스" Style="{StaticResource Text.H2}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="닫기" Style="{StaticResource Button.Ghost}"
                                MinWidth="0" Padding="20,0" Command="{Binding CloseLicenseViewerCommand}" />
                    </Grid>

                    <!-- 안내 1줄: GPLv3 적용 사실을 앱 안에서 명시한다(GPLv3 §4 고지 의무). -->
                    <TextBlock Grid.Row="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="이 소프트웨어는 동영상 처리에 FFmpeg(GPLv3)를 사용합니다. MC포토 본체는 MIT 라이선스입니다. 아래에서 전문을 확인할 수 있습니다." />

                    <!-- 좌: 문서 목록(폭 260 고정) / 우: 본문 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <!-- 고정 260: Auto로 두면 긴 파일명이 본문 영역을 잡아먹는다.
                                 대신 항목은 말줄임 + ToolTip으로 전체 이름을 보여준다(고정폭 잘림 대비). -->
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="문서" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,4" />
                            <!-- ⚠️ SelectedItem(값 기반) — SelectedIndex 바인딩은 목록 채움이 초기 선택을 덮는다(it7 B9). -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding LicenseDocuments}"
                                     SelectedItem="{Binding SelectedLicenseDocument}"
                                     Background="{StaticResource Brush.Surface.Alt}"
                                     BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- 본문. ⚠️ ScrollViewer로 감싸지 않는다 — 감싸면 TextBox가 무한 높이를 요구해
                             자체 스크롤이 죽는다. TextWrapping="NoWrap"인 이유: 원문이 이미 ~70열로 정렬돼 있어
                             Wrap을 걸면 창 폭에 따라 문단이 재배치되고 "그대로"가 깨진다 → 수평 스크롤을 제공한다.
                             TextBox(TextBlock 아님)인 이유: 전문을 인용할 상황이 있으므로 **선택·복사**가 가능해야 한다.
                             등폭 폰트가 원문 정렬(구분선·들여쓰기)을 보존한다(한글은 Malgun Gothic으로 폴백). -->
                        <TextBox Grid.Column="1" Text="{Binding LicenseText, Mode=OneWay}"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="13"
                                 Padding="12"
                                 Background="{StaticResource Brush.Surface.Alt}"
                                 BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1"
                                 Visibility="{Binding HasLicenseError, Converter={StaticResource InverseBoolToVis}}" />

                        <!-- 실패 안내(§C6 F1~F6). 문구에 경로가 없다(요구) — 경로는 로그에만 남는다. -->
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="{StaticResource Brush.Warning.Surface}"
                                CornerRadius="{StaticResource Radius.S}" Padding="16,14"
                                Visibility="{Binding HasLicenseError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LicenseErrorMessage}" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" />
                        </Border>

                        <!-- 읽는 동안(느린 저장소 대비). 클릭 비간섭이라 본문 조작을 막지 않는다. -->
                        <TextBlock Grid.Column="1" Text="불러오는 중…" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding IsLicenseLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- 선택 파일명 · 크기: 전문 여부를 사용자가 가늠할 수 있게 한다(경로는 없다). -->
                    <TextBlock Grid.Row="3" Text="{Binding LicenseSelectionSummary}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Text.Muted}" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
