<UserControl x:Class="MCPhoto.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="#141018">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="MC포토" Foreground="#F5F0FA" FontSize="72" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="셀프 포토부스" Foreground="#B9A7D0" FontSize="24"
                       HorizontalAlignment="Center" Margin="0,8,0,48" />
            <Button Content="촬영하기"
                    Command="{Binding StartCommand}"
                    FontSize="32" Padding="64,24" Background="#C44B9B" Foreground="White"
                    BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
