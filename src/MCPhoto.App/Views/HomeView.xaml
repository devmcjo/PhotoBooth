<UserControl x:Class="MCPhoto.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}">
        <!-- 배경 파스텔 포인트(로즈/민트 soft 원, 비텍스트 장식) -->
        <Ellipse Width="360" Height="360" Fill="{StaticResource Brush.Accent.Soft}" Opacity="0.6"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-120,0,0" />
        <Ellipse Width="300" Height="300" Fill="{StaticResource Brush.Accent2.Soft}" Opacity="0.6"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="MC포토" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" />
            <TextBlock Text="셀프 포토부스" Style="{StaticResource Text.H2}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center" Margin="0,8,0,48" />
            <Button Content="촬영하기" Command="{Binding StartCommand}"
                    Style="{StaticResource Button.Primary}"
                    Height="72" FontSize="24" Padding="72,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
