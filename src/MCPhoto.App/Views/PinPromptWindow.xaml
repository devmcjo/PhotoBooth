<Window x:Class="MCPhoto.App.Views.PinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIN 확인" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Brush.Bg}">
    <StackPanel Margin="28">
        <TextBlock x:Name="TitleText" Text="설정 잠김" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
        <TextBlock x:Name="DescText" Text="설정 진입 PIN을 입력하세요(4자리 숫자)." Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,16" TextWrapping="Wrap" />

        <!-- PIN 입력(확인 모드=1개, 설정 모드=2개). PasswordBox로 마스킹, 4자리 숫자만. -->
        <TextBlock x:Name="Pin1Label" Text="PIN" Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,4" />
        <PasswordBox x:Name="Pin1" Height="40" MaxLength="4" VerticalContentAlignment="Center" Padding="10,0"
                     PreviewTextInput="OnPinPreviewTextInput" KeyDown="OnKeyDown" />

        <!-- 설정 모드에서만 노출되는 2차 입력(확인) -->
        <StackPanel x:Name="ConfirmSection" Visibility="Collapsed">
            <TextBlock Text="PIN 확인" Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,12,0,4" />
            <PasswordBox x:Name="Pin2" Height="40" MaxLength="4" VerticalContentAlignment="Center" Padding="10,0"
                         PreviewTextInput="OnPinPreviewTextInput" KeyDown="OnKeyDown" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        <TextBlock x:Name="BusyText" Text="확인 중…" Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ConfirmButton" Content="확인" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Click="OnConfirm" />
            <Button x:Name="CancelButton" Content="취소" Style="{StaticResource Button.Ghost}" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
