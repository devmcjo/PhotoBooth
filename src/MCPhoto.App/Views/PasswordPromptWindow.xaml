<Window x:Class="MCPhoto.App.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 확인" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Brush.Bg}">
    <StackPanel Margin="28">
        <TextBlock Text="설정 잠김" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
        <TextBlock Text="현재 로그인 계정의 비밀번호를 입력하세요." Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,16" />
        <PasswordBox x:Name="Pw" Height="40" VerticalContentAlignment="Center" Padding="10,0" KeyDown="OnKeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="확인" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Click="OnConfirm" />
            <Button Content="취소" Style="{StaticResource Button.Ghost}" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
