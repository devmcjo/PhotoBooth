<UserControl x:Class="MCPhoto.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="#141018">
        <!-- 로그인 게이트 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="관리자 로그인" Foreground="#F5F0FA" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />
            <TextBox Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18" Padding="10" Margin="0,0,0,12" />
            <PasswordBox x:Name="AdminPassword" FontSize="18" Padding="10" Margin="0,0,0,8"
                         PasswordChanged="OnPasswordChanged" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF7B7B" FontSize="13" Margin="0,0,0,12" />
            <Button Content="로그인" Command="{Binding LoginCommand}"
                    FontSize="18" Padding="0,12" Background="#C44B9B" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" />
            <Button Content="닫기" Command="{Binding CloseCommand}"
                    FontSize="14" Background="Transparent" Foreground="#8574A0" BorderThickness="0" Cursor="Hand" />
        </StackPanel>

        <!-- 설정 편집 -->
        <ScrollViewer Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto" Margin="40,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                <TextBlock Text="관리자 모드 · 설정" Foreground="#F5F0FA" FontSize="28" FontWeight="Bold"
                           Margin="0,0,0,24" />

                <TextBlock Text="촬영 컷 수 (6/8/10)" Foreground="#B9A7D0" Margin="0,0,0,4" />
                <TextBox Text="{Binding CutCount}" FontSize="16" Padding="8" Margin="0,0,0,14" />

                <TextBlock Text="컷당 카운트다운 (3/6/8/10)" Foreground="#B9A7D0" Margin="0,0,0,4" />
                <TextBox Text="{Binding CountdownSec}" FontSize="16" Padding="8" Margin="0,0,0,14" />

                <CheckBox Content="거울모드" IsChecked="{Binding MirrorMode}" Foreground="#E8DEF2" Margin="0,0,0,10" />
                <CheckBox Content="플래시" IsChecked="{Binding FlashMode}" Foreground="#E8DEF2" Margin="0,0,0,10" />
                <CheckBox Content="QR 전송" IsChecked="{Binding EnableQrDelivery}" Foreground="#E8DEF2" Margin="0,0,0,10" />
                <CheckBox Content="로컬 저장" IsChecked="{Binding SaveLocalCopy}" Foreground="#E8DEF2" Margin="0,0,0,14" />

                <TextBlock Text="보관 시간 (1~72h)" Foreground="#B9A7D0" Margin="0,0,0,4" />
                <TextBox Text="{Binding RetentionHours}" FontSize="16" Padding="8" Margin="0,0,0,14" />

                <TextBlock Text="로컬 저장 경로" Foreground="#B9A7D0" Margin="0,0,0,4" />
                <TextBox Text="{Binding LocalSavePath}" FontSize="16" Padding="8" Margin="0,0,0,14" />

                <TextBlock Text="다운로드 페이지 Base URL" Foreground="#B9A7D0" Margin="0,0,0,4" />
                <TextBox Text="{Binding HostingBaseUrl}" FontSize="16" Padding="8" Margin="0,0,0,14" />

                <TextBlock Text="카메라 장치 인덱스" Foreground="#B9A7D0" Margin="0,0,0,4" />
                <TextBox Text="{Binding CameraDevice}" FontSize="16" Padding="8" Margin="0,0,0,20" />

                <TextBlock Text="{Binding SavedNotice}" Foreground="#7BE6A0" FontSize="14" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="저장" Command="{Binding SaveSettingsCommand}"
                            FontSize="16" Padding="28,12" Margin="0,0,10,0" Background="#C44B9B" Foreground="White"
                            BorderThickness="0" Cursor="Hand" />
                    <Button Content="사용자 관리" Command="{Binding OpenUserManagementCommand}"
                            Visibility="{Binding IsPower, Converter={StaticResource BoolToVis}}"
                            FontSize="16" Padding="20,12" Margin="0,0,10,0" Background="#332B3E" Foreground="#E8DEF2"
                            BorderThickness="0" Cursor="Hand" />
                    <Button Content="앱 종료" Command="{Binding ExitAppCommand}"
                            FontSize="16" Padding="20,12" Margin="0,0,10,0" Background="#5A2B2B" Foreground="#F0C0C0"
                            BorderThickness="0" Cursor="Hand" />
                    <Button Content="닫기" Command="{Binding CloseCommand}"
                            FontSize="16" Padding="20,12" Background="Transparent" Foreground="#8574A0"
                            BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
