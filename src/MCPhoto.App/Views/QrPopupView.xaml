<UserControl x:Class="MCPhoto.App.Views.QrPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <!-- 스크림 위 카드 다이얼로그(모달). 업로드중/성공(QR)/실패 3상태를 Visibility로 분기(it5 §2 B6). -->
    <Grid Background="{StaticResource Brush.Scrim}">
        <Border Style="{StaticResource Card}" Padding="48" Effect="{StaticResource Shadow.Pop}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Background="{StaticResource Brush.Bg}">
            <StackPanel>

                <!-- ① 업로드 중: 진행 바 + 단계 라벨(it11 #16). 세밀 진행 불가 시 IsIndeterminate로 무한 표시. -->
                <StackPanel Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource Text.Body}"
                               HorizontalAlignment="Center" />
                    <ProgressBar Height="8" Margin="0,16,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding UploadProgress}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Foreground="{StaticResource Brush.Accent}"
                                 Background="{StaticResource Brush.Divider}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- ② 성공: QR + 만료 안내 -->
                <StackPanel Visibility="{Binding UploadSucceeded, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="QR을 스캔하세요" Style="{StaticResource Text.H2}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <!-- QR 코드 배경은 스캔 위해 흰색 필수(예외). -->
                    <Border Background="{StaticResource Brush.OnAccent}" Padding="16" CornerRadius="8"
                            HorizontalAlignment="Center" Margin="0,0,0,20"
                            Effect="{StaticResource Shadow.Sm}">
                        <Image Source="{Binding QrImage}" Width="240" Height="240" />
                    </Border>
                    <TextBlock Text="{Binding ExpiryNotice}" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                </StackPanel>

                <!-- ③ 실패: 비위협 안내(로컬 저장됨) — 흐름 비차단([완료]로 진행 가능) -->
                <StackPanel Visibility="{Binding UploadFailed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Body}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <Button Content="다시 시도" Command="{Binding RetryCommand}"
                            Style="{StaticResource Button.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                </StackPanel>

                <!-- 완료: 성공·실패 어느 상태든 세션 완료로 진행(실패해도 비차단). 업로드 중엔 숨김. -->
                <Button Content="완료" Command="{Binding DoneCommand}"
                        Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" Padding="40,0"
                        Visibility="{Binding IsUploading, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
