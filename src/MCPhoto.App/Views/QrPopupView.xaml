<UserControl x:Class="MCPhoto.App.Views.QrPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <!-- 스크림 위 카드 다이얼로그(모달) -->
    <Grid Background="{StaticResource Brush.Scrim}">
        <Border Style="{StaticResource Card}" Padding="48" Effect="{StaticResource Shadow.Pop}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Background="{StaticResource Brush.Bg}">
            <StackPanel>
                <TextBlock Text="QR을 스캔하세요" Style="{StaticResource Text.H2}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"
                           Visibility="{Binding UploadSucceeded, Converter={StaticResource BoolToVis}}" />

                <!-- 업로드 중 -->
                <TextBlock Text="업로드 중..." Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}" />

                <!-- QR (업로드 성공 후에만). QR 코드 배경은 스캔 위해 흰색 필수(예외). -->
                <Border Background="{StaticResource Brush.OnAccent}" Padding="16" CornerRadius="8"
                        HorizontalAlignment="Center" Margin="0,0,0,20"
                        Effect="{StaticResource Shadow.Sm}"
                        Visibility="{Binding UploadSucceeded, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding QrImage}" Width="240" Height="240" />
                </Border>

                <TextBlock Text="{Binding ExpiryNotice}" Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           Visibility="{Binding UploadSucceeded, Converter={StaticResource BoolToVis}}" />

                <!-- 실패 안내 -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Danger}"
                           Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,0,16" />
                <Button Content="다시 시도" Command="{Binding RetryCommand}"
                        Style="{StaticResource Button.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,12"
                        Visibility="{Binding UploadSucceeded, Converter={StaticResource InverseBoolToVis}}" />

                <Button Content="홈으로" Command="{Binding GoHomeCommand}"
                        Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" Padding="40,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
