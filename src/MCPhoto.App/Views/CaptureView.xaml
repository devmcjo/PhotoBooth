<UserControl x:Class="MCPhoto.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <!-- 촬영 화면은 프리뷰 몰입 위해 예외적 다크 배경(Brush.CaptureBg, §부록 A). 오버레이 텍스트는 다크 위라 밝게 유지. -->
    <Grid Background="{StaticResource Brush.CaptureBg}">
        <Image x:Name="PreviewImage" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="LowQuality" />

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.OnAccent}" FontSize="22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

        <!-- it23 §6.5 W8: 프리뷰 부재 안내(외부 카메라 소스 + 웹캠 없음). 프리뷰 Image 위에만 덮는다 —
             카운트다운·셔터·플래시는 정상 동작하므로 상호작용을 막지 않는다(IsHitTestVisible=False). -->
        <TextBlock Text="프리뷰 없음 — 외부 카메라로 촬영됩니다"
                   Foreground="{StaticResource Brush.OnAccent}" FontSize="20" Opacity="0.85"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding PreviewAbsent, Converter={StaticResource BoolToVis}}" />

        <!-- 컷 진행 표시 + it23 배지·배너(좌상단 세로 스택 — 서로 가리지 않는다) -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20">
            <Border Background="{StaticResource Brush.Scrim}" CornerRadius="6" Padding="14,8"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentCut}" Foreground="{StaticResource Brush.OnAccent}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text=" / " Foreground="{StaticResource Brush.OnAccent}" FontSize="20" Opacity="0.7" />
                    <TextBlock Text="{Binding TotalCuts}" Foreground="{StaticResource Brush.OnAccent}" FontSize="20" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- W4 상시 배지: 프리뷰(웹캠)와 결과물(DSLR)이 다른 광학계라는 사실은 세션 내내 참이다.
                 촬영 순간마다 안내하면 카운트다운 UX를 방해하므로 상시 배지가 정직하다(설계 §5.4 고지 ②).
                 게스트(손님)에게도 보인다 — 결과물이 프리뷰와 다르게 나오는 것을 겪는 당사자다. -->
            <Border Background="{StaticResource Brush.Scrim}" CornerRadius="6" Padding="12,6"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding IsExternalSource, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="외부 카메라 촬영 중 — 프리뷰는 참고용입니다"
                           Foreground="{StaticResource Brush.OnAccent}" FontSize="14" />
            </Border>

            <!-- W6 강등 배너: 세션 잔여 기간 내내 유지된다(앞 컷과 뒤 컷의 화질이 달라진 사실의 고지). -->
            <Border Background="{StaticResource Brush.Warning.Surface}" CornerRadius="6" Padding="12,6"
                    HorizontalAlignment="Left" Margin="0,8,0,0" MaxWidth="420"
                    Visibility="{Binding HasDegradeBanner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DegradeBanner}" Foreground="{StaticResource Brush.Warning}"
                           FontSize="14" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- 카운트다운(펄스 애니메이션). it23: 수신 대기 중에는 숨긴다 — 이전 컷의 남은 숫자가
             "사진 전송 중" 오버레이 뒤로 겹쳐 보이면 다음 컷이 시작된 것처럼 오해된다(설계 §6.3). -->
        <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" Height="220" RenderTransformOrigin="0.5,0.5"
                 Visibility="{Binding IsReceiving, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock x:Name="CountdownText" Text="{Binding RemainingSeconds}"
                       Foreground="{StaticResource Brush.OnAccent}" FontWeight="Bold" Opacity="0.9" />
        </Viewbox>

        <!-- it23 W5: DSLR 셔터 후 이미지 수신 대기(최대 CaptureTimeout). 카운트다운 숫자 대신 표시된다.
             수신은 수 초가 걸릴 수 있어(설계 A7) 아무 표시가 없으면 손님이 촬영 실패로 오해한다.
             신규 리소스 키를 만들지 않고 it20의 공유 스피너(Spinner.Ring)를 재사용한다(§12.3). -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVis}}">
            <Control Template="{StaticResource Spinner.Ring}" Width="56" Height="56"
                     HorizontalAlignment="Center" Focusable="False" IsTabStop="False" />
            <TextBlock Text="사진 전송 중…" Foreground="{StaticResource Brush.OnAccent}"
                       FontSize="20" HorizontalAlignment="Center" Margin="0,20,0,0" />
        </StackPanel>

        <!-- 바로 촬영 셔터 버튼 + 라벨(U5, it3 §8) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40">
            <Button Style="{StaticResource Button.Shutter}" Command="{Binding ShootNowCommand}"
                    HorizontalAlignment="Center" AutomationProperties.Name="바로 촬영" />
            <TextBlock Text="바로 촬영" Foreground="{StaticResource Brush.OnAccent}" Opacity="0.85"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- 취소 -->
        <Button Content="취소" Command="{Binding CancelCommand}"
                FontSize="15" Foreground="{StaticResource Brush.OnAccent}" Background="{StaticResource Brush.Scrim}"
                BorderThickness="0" Padding="16,8" Cursor="Hand"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" />

        <!-- 플래시 오버레이(흰 화면 펄스): FlashActive=true로 표시되는 순간 즉시 불투명하게 노출되고,
             표시된 후에는 자연스럽게 밝기가 살짝 빠지는 페이드를 반복해 눈부심을 완화한다.
             (버그 수정: 이전에는 Opacity="0" 고정이라 FlashActive가 true여도 화면이 보이지 않았음) -->
        <Border x:Name="FlashOverlay" Background="{StaticResource Brush.OnAccent}"
                Visibility="{Binding FlashActive, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.55" Duration="0:0:0.12"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- 카메라 로딩 오버레이(U4): CameraState==Initializing일 때만. 스피너 + 안내. (it3 §7.2) -->
        <Grid Background="{StaticResource Brush.Scrim}"
              Visibility="{Binding CameraState, Converter={StaticResource CameraStateToVis}, ConverterParameter=Initializing}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 회전 스피너(링) — Storyboard 무한 회전, 코드비하인드 없음 -->
                <Ellipse Width="56" Height="56" HorizontalAlignment="Center"
                         Stroke="{StaticResource Brush.Accent}" StrokeThickness="5"
                         StrokeDashArray="4 2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="카메라 준비 중…" Foreground="{StaticResource Brush.OnAccent}"
                           FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
