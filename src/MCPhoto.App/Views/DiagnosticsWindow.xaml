<Window x:Class="MCPhoto.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="진단·상태" Width="720" Height="760"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}">
    <!-- 관리자 트러블슈팅용 진단 화면(모달). 카메라/ffmpeg/Firebase 헬스체크 + 로그 폴더. (it11 §3.14.8) -->
    <Window.Resources>
        <!-- 헬스 상태 배지: 정상=성공(민트) / 이상=danger(로즈). 신규 리소스 키 없이 기존 팔레트만 사용. -->
        <Style x:Key="HealthValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="32,28,32,16">
            <StackPanel>
                <TextBlock Text="진단·상태" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                <TextBlock Text="관리자 트러블슈팅용 · 각 항목의 상태를 확인하고 로그 폴더를 열 수 있습니다."
                           Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"
                           Margin="0,0,0,20" />

                <!-- ══════════ 카메라 ══════════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="카메라" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="다시 검사" Style="{StaticResource Button.Secondary}"
                                    MinWidth="0" Padding="16,0" Command="{Binding RefreshCamerasCommand}"
                                    IsEnabled="{Binding IsCheckingCamera, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="상태" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <!-- 검사 중이면 "검사 중…", 아니면 요약. 연결=성공색 / 미연결=danger. -->
                            <TextBlock Grid.Column="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HealthValue}">
                                        <Setter Property="Text" Value="{Binding CameraSummary}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCamera}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCheckingCamera}" Value="True">
                                                <Setter Property="Text" Value="검사 중…" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- 장치 목록(Index · Name). 없으면 빈 목록(항목 미노출). -->
                        <ItemsControl ItemsSource="{Binding Cameras}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,2,0,0">
                                        <Run Text="•" Foreground="{StaticResource Brush.Text.Muted}" />
                                        <Run Text="{Binding Index, Mode=OneWay, StringFormat='#{0}'}" Foreground="{StaticResource Brush.Text.Muted}" />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════════ ffmpeg ══════════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ffmpeg(녹화·타임랩스)" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="상태" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HealthValue}">
                                        <Setter Property="Text" Value="미탑재" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FfmpegAvailable}" Value="True">
                                                <Setter Property="Text" Value="사용 가능" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="경로" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Top" />
                            <TextBox Grid.Column="1" Text="{Binding FfmpegPath, Mode=OneWay}" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                     Foreground="{StaticResource Brush.Text.Muted}" Padding="0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════ 서버 연결(백엔드) it15 §6.6 ══════════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="서버 연결(백엔드)" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="백엔드 구성" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HealthValue}">
                                        <Setter Property="Text" Value="미구성" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBackendConfigured}" Value="True">
                                                <Setter Property="Text" Value="구성됨" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="백엔드 주소" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BackendBaseUrl, Mode=OneWay}" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                     Foreground="{StaticResource Brush.Text.Muted}" Padding="0" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="백엔드 키 내장" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <!-- ⚠️ 키 값 자체는 절대 표시하지 않는다 — "설정됨/미설정" 부울 표기만. -->
                            <TextBlock Grid.Column="1" Style="{StaticResource HealthValue}" Text="{Binding BackendApiKeyState}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="스토리지 버킷" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HealthValue}" Text="{Binding FirebaseBucket}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그인 계정" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HealthValue}" Text="{Binding SignedInAccount}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════ 로그 ══════════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="로그" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                        <TextBlock Text="폴더 경로" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,4" />
                        <!-- 경로는 항상 표시(선택·복사 가능) — 탐색기 열기 실패(키오스크)해도 수동 탐색 가능. -->
                        <TextBox Text="{Binding LogFolderPath, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Content="로그 폴더 열기" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left" MinWidth="0" Padding="20,0"
                                Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </Border>

                <!-- ══════════ 개발자 문의 ══════════ -->
                <!-- 문의 시 그대로 옮겨 적을 수 있게 연락처·버전·빌드일·웹 배포일을 한 카드에 모은다.
                     버전/빌드일 = 로컬 bldinfo.ini, 웹 배포일 = 서버 GET /health(deployedAt) — 출처가 달라
                     두 값은 어긋날 수 있고, 그 차이 자체가 "앱만 오래됨/웹만 오래됨" 진단 정보다. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="개발자 문의" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Developer" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <!-- 주소는 항상 선택·복사 가능한 TextBox로 둔다(복사 버튼이 실패해도 수동 복사 가능). -->
                            <TextBox Grid.Column="1" Text="{Binding DeveloperEmail, Mode=OneWay}" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="복사" Style="{StaticResource Button.Secondary}"
                                    MinWidth="0" Padding="16,0" Command="{Binding CopyDeveloperEmailCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HealthValue}" Text="{Binding AppVersion}" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Build Date" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HealthValue}" Text="{Binding AppBuildDate}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Web Deploy Date" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <!-- 조회 중이면 "확인 중…"으로 덮어쓴다(카메라 검사와 동일 패턴). -->
                            <TextBlock Grid.Column="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HealthValue}">
                                        <Setter Property="Text" Value="{Binding WebDeployDate}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingWebDeploy}" Value="True">
                                                <Setter Property="Text" Value="확인 중…" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="다시 확인" Style="{StaticResource Button.Secondary}"
                                    MinWidth="0" Padding="16,0" Command="{Binding RefreshWebDeployDateCommand}"
                                    IsEnabled="{Binding IsCheckingWebDeploy, Converter={StaticResource InverseBool}}" />
                        </Grid>

                        <!-- 복사 결과 안내: 값이 없으면 자리를 차지하지 않는다. -->
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Text" Value="{Binding CopyNotice}" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CopyNotice}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- sticky 하단 바: 닫기(설정 화면과 동일 패턴). Close는 code-behind(DialogResult). -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Bg}" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Brush.Divider}" Effect="{StaticResource Shadow.Sm}"
                Padding="32,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="닫기" Style="{StaticResource Button.Ghost}"
                        Click="OnCloseClick" Margin="8,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
