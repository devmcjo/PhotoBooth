<UserControl x:Class="MCPhoto.App.Views.FrameSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="프레임 선택" Style="{StaticResource Text.H1}"
                   HorizontalAlignment="Center" Margin="0,88,0,16" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                 Background="Transparent" BorderThickness="0" Margin="40,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- 선택 시 로즈 테두리 강조(디자인 시스템) -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="10" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{StaticResource Brush.Surface}"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        CornerRadius="{StaticResource Radius.M}"
                                        Effect="{StaticResource Shadow.Sm}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Shadow.Card}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="200" Height="280">
                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="10" />
                        <Border Background="{StaticResource Brush.Scrim}" CornerRadius="0,0,12,12"
                                VerticalAlignment="Bottom" Height="36">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.OnAccent}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,32">
            <Button Content="프레임 만들기" Command="{Binding CreateFrameCommand}"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource Button.Secondary}" Margin="8,0" />
            <Button Content="다음" Command="{Binding NextCommand}"
                    Style="{StaticResource Button.Primary}" Padding="48,0" Margin="8,0" />
            <Button Content="취소" Command="{Binding CancelCommand}"
                    Style="{StaticResource Button.Ghost}" Margin="8,0" />
        </StackPanel>
    </Grid>
</UserControl>
