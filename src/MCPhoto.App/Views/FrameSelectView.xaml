<UserControl x:Class="MCPhoto.App.Views.FrameSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="#141018">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="프레임 선택" Foreground="#F5F0FA" FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,32,0,16" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                 Background="Transparent" BorderThickness="0" Margin="40,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="200" Height="280" Margin="10" Background="#241E30" CornerRadius="6">
                        <Grid>
                            <Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="8" />
                            <TextBlock Text="{Binding Name}" Foreground="#E8DEF2" FontSize="14"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,32">
            <Button Content="프레임 만들기" Command="{Binding CreateFrameCommand}"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                    FontSize="18" Padding="28,14" Margin="8,0" Background="#332B3E" Foreground="#E8DEF2"
                    BorderThickness="0" Cursor="Hand" />
            <Button Content="다음" Command="{Binding NextCommand}"
                    FontSize="20" Padding="48,14" Margin="8,0" Background="#C44B9B" Foreground="White"
                    BorderThickness="0" Cursor="Hand" />
            <Button Content="취소" Command="{Binding CancelCommand}"
                    FontSize="16" Padding="20,14" Margin="8,0" Background="Transparent" Foreground="#8574A0"
                    BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
