<UserControl x:Class="MCPhoto.App.Views.FrameSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="프레임 선택" Style="{StaticResource Text.H1}"
                   HorizontalAlignment="Center" Margin="0,88,0,16" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                 Background="Transparent" BorderThickness="0" Margin="40,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- 선택 시 로즈 테두리 강조(디자인 시스템) -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="10" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{StaticResource Brush.Surface}"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        CornerRadius="{StaticResource Radius.M}"
                                        Effect="{StaticResource Shadow.Sm}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Shadow.Card}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="200" Height="280">
                        <!-- 파일 잠금 없이 로드(삭제 가능). FilePathToImage: OnLoad+IgnoreImageCache. (it9 후속) -->
                        <Image Source="{Binding ImageUrl, Converter={StaticResource FilePathToImage}}"
                               Stretch="Uniform" Margin="10" />
                        <!-- 슬롯 위치 미리보기: 프레임 픽셀 좌표(ImageSize)를 Viewbox로 이미지와 동일 스케일 →
                             슬롯 개수·위치를 선택 전에 확인. ImageSize=0(메타 없음)이면 자동으로 안 그려짐. -->
                        <Viewbox Margin="10" Stretch="Uniform">
                            <ItemsControl Width="{Binding ImageSize.Width}" Height="{Binding ImageSize.Height}"
                                          ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                   Fill="#33FF4D79" Stroke="{StaticResource Brush.Accent}" StrokeThickness="10" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                        <Border Background="{StaticResource Brush.Scrim}" CornerRadius="0,0,12,12"
                                VerticalAlignment="Bottom" Height="36">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.OnAccent}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <!-- A3(정정): 삭제 ✕. 로그인 사용자는 본인 로컬 프레임, 파워(manager/admin)는 공용·DB 프레임도. 번들/fallback·게스트 미노출. -->
                        <Button Content="✕" FontSize="14" Width="28" Height="28"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Style="{StaticResource Button.Icon}"
                                Command="{Binding DataContext.RequestDeleteCommand,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="프레임 삭제">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource FrameDeleteVis}">
                                    <Binding Path="DataContext.CanDeleteFrames" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="DataContext.IsPower" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="Id" />
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- A3: 삭제 확인 팝업(오버레이). 파워면 "서버에서도 제거" 체크(기본 off). -->
        <Grid Grid.RowSpan="3" Background="{StaticResource Brush.Scrim}"
              Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="32" Effect="{StaticResource Shadow.Pop}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380"
                    Background="{StaticResource Brush.Bg}">
                <StackPanel>
                    <TextBlock Text="이 프레임을 삭제하시겠습니까?" Style="{StaticResource Text.H2}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding FrameToDelete.Name}" Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <CheckBox Content="서버에서도 제거" IsChecked="{Binding DeleteAlsoServer}"
                              Visibility="{Binding IsPower, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,0,20" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="삭제" Command="{Binding ConfirmDeleteCommand}"
                                Style="{StaticResource Button.Danger}" Margin="0,0,12,0" />
                        <Button Content="취소" Command="{Binding CancelDeleteCommand}"
                                Style="{StaticResource Button.Ghost}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,20">
            <!-- 삭제 결과 안내(서버 삭제 성공/실패/미발견). 성공=성공색, 실패=danger색. -->
            <TextBlock Text="{Binding DeleteNotice}" HorizontalAlignment="Center" Margin="0,0,0,8"
                       Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{Binding DeleteNoticeIsError, Converter={StaticResource BoolToNoticeBrush}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="프레임 만들기" Command="{Binding CreateFrameCommand}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource Button.Secondary}" Margin="8,0" />
                <!-- 선택 프레임 편집(본인 로컬 or 파워). 파워가 만든 공용/DB 프레임은 저장 시 DB도 갱신. -->
                <Button Content="선택 편집" Command="{Binding EditFrameCommand}"
                        Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource Button.Secondary}" Margin="8,0" />
                <Button Content="다음" Command="{Binding NextCommand}"
                        Style="{StaticResource Button.Primary}" Padding="48,0" Margin="8,0" />
                <Button Content="취소" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Ghost}" Margin="8,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
