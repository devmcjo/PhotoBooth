<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Direction A 라이트 팔레트("코튼 캔디") — 순수 Color 원자값.
        확정 6색 + 라이트 적응 보강값. (wpf-it2-design.md §2.3)
        용도 제약은 §2.3.1 대비표를 따른다(민트 텍스트 금지 등).
    -->

    <!-- ── 배경/표면 ── -->
    <Color x:Key="Color.Bg">#FFFFFF</Color>
    <Color x:Key="Color.Bg.Elevated">#FAF8FC</Color>
    <Color x:Key="Color.Surface">#F4F1F7</Color>
    <Color x:Key="Color.Surface.Alt">#ECE8F0</Color>
    <Color x:Key="Color.Surface.Hover">#E4DEEC</Color>
    <Color x:Key="Color.Surface.Press">#DAD2E4</Color>
    <Color x:Key="Color.Border">#ECE8F0</Color>
    <Color x:Key="Color.Divider">#E4DEEC</Color>

    <!-- ── 텍스트(Ink 계열) ── -->
    <Color x:Key="Color.Text.Primary">#241F2B</Color>
    <Color x:Key="Color.Text.Secondary">#4A4453</Color>
    <Color x:Key="Color.Text.Tertiary">#6E6878</Color>
    <Color x:Key="Color.Text.Muted">#8A8494</Color>

    <!-- ── 강조: 로즈(Primary CTA) ── -->
    <Color x:Key="Color.Accent">#FF4D79</Color>
    <Color x:Key="Color.Accent.Hover">#FF6B8F</Color>
    <Color x:Key="Color.Accent.Press">#E43C67</Color>
    <Color x:Key="Color.Accent.Text">#D6376A</Color>
    <Color x:Key="Color.Accent.Soft">#FFE7EE</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>

    <!-- ── 보조: 민트(비텍스트 포인트) ── -->
    <Color x:Key="Color.Accent2">#37C9B0</Color>
    <Color x:Key="Color.Accent2.Soft">#DFF6F1</Color>
    <Color x:Key="Color.Accent2.Text">#128A76</Color>

    <!-- ── 시맨틱 ── -->
    <Color x:Key="Color.Success">#128A76</Color>
    <Color x:Key="Color.Success.Surface">#DFF6F1</Color>
    <Color x:Key="Color.Danger">#D92D4E</Color>
    <Color x:Key="Color.Danger.Hover">#C22645</Color>
    <Color x:Key="Color.Danger.Surface">#FDE8EC</Color>
    <Color x:Key="Color.Warning">#B26A00</Color>
    <Color x:Key="Color.Warning.Surface">#FFF3DE</Color>

    <!-- ── 상태 ── -->
    <Color x:Key="Color.Disabled.Bg">#ECE8F0</Color>
    <Color x:Key="Color.Disabled.Fg">#B4AEBE</Color>

    <!-- ── 오버레이/예외 ── -->
    <!-- Scrim: Ink 40%(#66 알파) -->
    <Color x:Key="Color.Scrim">#66241F2B</Color>
    <!-- 촬영 화면 몰입 배경(예외적 다크, §부록 A) -->
    <Color x:Key="Color.CaptureBg">#111114</Color>

    <!-- 그림자 기본 색(Ink) -->
    <Color x:Key="Color.Shadow">#241F2B</Color>
</ResourceDictionary>
