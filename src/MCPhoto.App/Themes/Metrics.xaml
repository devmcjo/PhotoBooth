<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        간격·모서리·터치·엘리베이션. (wpf-it2-design.md §2.5)
        라이트 soft shadow 3단계(저투명 Ink). 그림자는 카드/팝업 한정 — 30fps 렌더 표면 금지.

        ⚠️ Shadow.*가 Color.Shadow를 StaticResource로 참조하므로 Colors.xaml을 자체 병합
        (별도 병합 딕셔너리 간 StaticResource 교차 참조 불가 회피).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ── Spacing (double) ── -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">16</sys:Double>
    <sys:Double x:Key="Space.L">24</sys:Double>
    <sys:Double x:Key="Space.XL">40</sys:Double>
    <sys:Double x:Key="Space.XXL">64</sys:Double>

    <!-- ── Spacing (Thickness, 여백/패딩용) ── -->
    <Thickness x:Key="Pad.S">8</Thickness>
    <Thickness x:Key="Pad.M">16</Thickness>
    <Thickness x:Key="Pad.L">24</Thickness>
    <Thickness x:Key="Pad.XL">40</Thickness>

    <!-- ── CornerRadius ── -->
    <CornerRadius x:Key="Radius.S">8</CornerRadius>
    <CornerRadius x:Key="Radius.M">14</CornerRadius>
    <CornerRadius x:Key="Radius.L">24</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ── 터치 타깃 ── -->
    <sys:Double x:Key="Touch.Min">48</sys:Double>
    <sys:Double x:Key="Touch.CTA">56</sys:Double>
    <sys:Double x:Key="Touch.IconBtn">56</sys:Double>

    <!-- ── 엘리베이션(라이트 soft shadow) ── -->
    <DropShadowEffect x:Key="Shadow.Sm"
                      BlurRadius="8" ShadowDepth="1" Direction="270"
                      Opacity="0.06" Color="{StaticResource Color.Shadow}" />
    <DropShadowEffect x:Key="Shadow.Card"
                      BlurRadius="20" ShadowDepth="4" Direction="270"
                      Opacity="0.08" Color="{StaticResource Color.Shadow}" />
    <DropShadowEffect x:Key="Shadow.Pop"
                      BlurRadius="32" ShadowDepth="8" Direction="270"
                      Opacity="0.14" Color="{StaticResource Color.Shadow}" />
</ResourceDictionary>
