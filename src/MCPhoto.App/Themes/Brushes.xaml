<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        테마 토큰 브러시. Colors.xaml의 Color를 참조하는 SolidColorBrush.
        리소스로 선언된 SolidColorBrush는 WPF가 자동 Freeze(성능). (wpf-it2-design.md §2.3)
        키는 역할 기반 — 재테마 시 Colors 값만 교체하면 됨.
        ⚠️ Brush.Glass는 정의하지 않음(glassmorphism 폐기, §2.3).

        ⚠️ StaticResource는 별도 병합 딕셔너리의 키를 교차 참조하지 못한다(각 RD가 독립 파싱).
        따라서 이 파일이 의존하는 Colors.xaml을 자체 MergedDictionaries로 포함해 Color.* 키를 해석한다.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ── 배경/표면 ── -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{StaticResource Color.Bg.Elevated}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="{StaticResource Color.Surface.Alt}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Surface.Press" Color="{StaticResource Color.Surface.Press}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />

    <!-- ── 텍스트 ── -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />

    <!-- ── 강조: 로즈 ── -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Press" Color="{StaticResource Color.Accent.Press}" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{StaticResource Color.Accent.Text}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />

    <!-- ── 보조: 민트 ── -->
    <SolidColorBrush x:Key="Brush.Accent2" Color="{StaticResource Color.Accent2}" />
    <SolidColorBrush x:Key="Brush.Accent2.Soft" Color="{StaticResource Color.Accent2.Soft}" />
    <SolidColorBrush x:Key="Brush.Accent2.Text" Color="{StaticResource Color.Accent2.Text}" />

    <!-- ── 시맨틱 ── -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Success.Surface" Color="{StaticResource Color.Success.Surface}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{StaticResource Color.Danger.Hover}" />
    <SolidColorBrush x:Key="Brush.Danger.Surface" Color="{StaticResource Color.Danger.Surface}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Warning.Surface" Color="{StaticResource Color.Warning.Surface}" />

    <!-- ── 상태 ── -->
    <SolidColorBrush x:Key="Brush.Disabled.Bg" Color="{StaticResource Color.Disabled.Bg}" />
    <SolidColorBrush x:Key="Brush.Disabled.Fg" Color="{StaticResource Color.Disabled.Fg}" />

    <!-- ── 오버레이/예외 ── -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.CaptureBg" Color="{StaticResource Color.CaptureBg}" />
</ResourceDictionary>
