<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MCPhoto.App.Converters">
    <!--
        컨트롤 스타일·템플릿. (wpf-it2-design.md §2.6)
        키오스크 터치(최소 48px)·상태별 트리거(hover/press/disabled/focus).
        버튼은 x:Key 명시 참조(암묵 스타일 없음 — 기존 인라인 버튼 보호).
        입력류(TextBox/PasswordBox/ComboBox/CheckBox)는 암묵 스타일 전역 적용.
        접근성(§2.3.1): 로즈 위 텍스트=Bold 16+, 민트엔 텍스트 금지.

        ⚠️ Brush.*/Radius.*/Touch.*/Shadow.*/Font.Primary/Text.H1을 StaticResource로 참조하므로
        의존 딕셔너리(Brushes·Metrics·Typography)를 자체 병합(각 RD 독립 파싱 → 교차 참조 불가 회피).
        Brushes는 Colors를, Typography는 Brushes를 전이 포함.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Metrics.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ══════════════ 공통: 포커스 비주얼 제거(커스텀 링 사용) ══════════════ -->
    <Style x:Key="NoFocusVisual">
        <Setter Property="Control.FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- ══════════════ Button.Primary (로즈 CTA) ══════════════ -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Touch.CTA}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.M}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Press}" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Disabled.Bg}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Button.Secondary (보조) ══════════════ -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Touch.CTA}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Alt}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.M}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Press}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Disabled.Bg}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Button.Ghost (취소·닫기 — 아웃라인, 3순위 위계) ══════════════ -->
    <!-- 채움 없는 아웃라인. Primary(채움 로즈)>Secondary(채움 뉴트럴)>Ghost(아웃라인) 위계.
         높이·폰트를 CTA와 맞춰 나란히 놓였을 때 정렬·가독. 테두리로 버튼임을 명확히(텍스트처럼 안 보이게). -->
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Touch.CTA}" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.M}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Text.Tertiary}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Press}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Disabled.Bg}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Button.Danger (삭제·앱 종료) ══════════════ -->
    <!-- 높이·폰트를 CTA와 맞춤 → 확인 다이얼로그에서 취소(Ghost)와 나란히 정렬. -->
    <Style x:Key="Button.Danger" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Touch.CTA}" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Background" Value="{StaticResource Brush.Danger.Surface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.S}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Disabled.Bg}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Button.Icon (상단 바 로그인/설정) ══════════════ -->
    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Touch.IconBtn}" />
        <Setter Property="Height" Value="{StaticResource Touch.IconBtn}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Press}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Button.Icon.Pill (아이콘+라벨, 너비 가변) ══════════════ -->
    <Style x:Key="Button.Icon.Pill" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="{StaticResource Touch.IconBtn}" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- ══════════════ Icon.Glyph / Button.TopBar (it21 §5.6·§6.2) ══════════════ -->
    <!--
        ⚠️ 이 절의 어떤 스타일도 Icon.Gear 등 **Geometry 키를 참조하지 않는다.**
           참조하는 순간 Controls → Icons 형제 딕셔너리 교차 참조가 되어 창이 뜨지 않는다.
           Geometry는 사용처(MainWindow.xaml / HomeView.xaml)가 Path.Data로 주입한다. (설계 §11 P1)
    -->

    <!-- 아이콘 Path 공통. Fill을 조상 버튼의 Foreground에 묶어 hover/disabled 색 정책을 버튼이 소유한다. -->
    <Style x:Key="Icon.Glyph" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" />
    </Style>

    <!--
        상단 바 버튼. Button.Icon(56px pill·hover/press 트리거)을 상속하고 배경만 덮는다.
        종전 Transparent 배경은 흰 배경 위에서 버튼인지 라벨인지 구분되지 않았다(설계 §3.4) —
        Surface 배경을 주어 좌/우 버튼들이 하나의 컨트롤 군으로 읽히게 한다.
    -->
    <Style x:Key="Button.TopBar" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    </Style>

    <!-- 브랜드-홈 칩(홈 글리프 + 워드마크). 너비 가변 — 워드마크는 런타임 교체될 수 있다. -->
    <Style x:Key="Button.TopBar.Brand" TargetType="Button" BasedOn="{StaticResource Button.TopBar}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="{StaticResource Touch.IconBtn}" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- ══════════════ Button.Filter (필터 칩) ══════════════ -->
    <Style x:Key="Button.Filter" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Touch.Min}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Alt}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                        <!-- 선택 표시: Tag="Selected"일 때 연로즈 배경 + 로즈 테두리 + 로즈 텍스트 -->
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Card (컨테이너 Border) ══════════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.L}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
    </Style>

    <!-- ══════════════ Button.FrameCard (프레임 선택 카드) ══════════════ -->
    <Style x:Key="Button.FrameCard" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource Radius.M}"
                            Effect="{StaticResource Shadow.Sm}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Shadow.Card}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Shadow.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ 프레임 카드 공유 리소스 (it15 F2-D3) ══════════════ -->
    <!-- 프레임 선택 화면과 편집기의 "기존 프레임 불러오기" 모달이 같은 썸네일 카드를 쓴다.
         시각 본체만 공유하고, 삭제 ✕ 버튼은 FrameSelectView가 자기 화면에서 합성한다
         (그 MultiBinding이 DataContext.CanDeleteFrames/IsPower를 ListBox 조상에서 찾으므로 피커로 새면 안 됨).
         ⚠️ 컨버터 인스턴스는 이 딕셔너리 안에 자체 정의한다 — RD는 독립 파싱이라 App.xaml의
         FilePathToImage를 StaticResource로 참조할 수 없다(키를 달리해 충돌 회피). -->
    <conv:FilePathToImageConverter x:Key="FrameCard.FilePathToImage" />

    <!-- 카드 컨테이너: 선택 시 로즈 테두리 강조(디자인 시스템) -->
    <Style x:Key="FrameCard.ItemContainer" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource Brush.Surface}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource Radius.M}"
                            Effect="{StaticResource Shadow.Sm}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Shadow.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 카드 본체(200×280): 이미지 + 슬롯 미리보기 + 이름 바. 삭제 ✕ 버튼은 포함하지 않는다. -->
    <DataTemplate x:Key="FrameCard.Content">
        <Grid Width="200" Height="280">
            <!-- 파일 잠금 없이 로드(삭제 가능). FilePathToImage: OnLoad+IgnoreImageCache. (it9 후속) -->
            <Image Source="{Binding ImageUrl, Converter={StaticResource FrameCard.FilePathToImage}}"
                   Stretch="Uniform" Margin="10" />
            <!-- 슬롯 위치 미리보기: 프레임 픽셀 좌표(ImageSize)를 Viewbox로 이미지와 동일 스케일 →
                 슬롯 개수·위치를 선택 전에 확인. ImageSize=0(메타 없음)이면 자동으로 안 그려짐. -->
            <Viewbox Margin="10" Stretch="Uniform">
                <ItemsControl Width="{Binding ImageSize.Width}" Height="{Binding ImageSize.Height}"
                              ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                       Fill="#33FF4D79" Stroke="{StaticResource Brush.Accent}" StrokeThickness="10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>
            <Border Background="{StaticResource Brush.Scrim}" CornerRadius="0,0,12,12"
                    VerticalAlignment="Bottom" Height="36">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.OnAccent}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ══════════════ Spinner.Ring (대기 스피너 공유 리소스, it20) ══════════════ -->
    <!-- 사용: <Control Template="{StaticResource Spinner.Ring}" Width="56" Height="56"
                       Focusable="False" IsTabStop="False" />
         ⚠️ RotateTransform에 x:Name을 달고 Storyboard.TargetName으로 겨냥한다 —
            속성 경로((UIElement.RenderTransform).(RotateTransform.Angle)) 방식은 템플릿 Seal로 동결된
            Freezable에서 "Cannot animate on an immutable object instance"를 던진다(설계 §4.5).
            그 예외는 UI 스레드 → DispatcherUnhandledException → 홈 복귀로 이어져,
            손님이 촬영을 누르면 튕기는 최악의 실패 모드가 된다.
            이 형태는 CaptureView.xaml:74-93에서 동작이 확인된 패턴과 동일하다.
         ⚠️ 시작은 Loaded(발화 보장), 정지/재개는 IsVisible 트리거가 담당한다 — 오버레이가 Collapsed되면
            Forever 애니메이션이 계속 도는 낭비를 막는다. IsVisible=True 진입 트리거로 시작하면
            템플릿 적용 시점에 이미 Visible인 경우(오버레이 초기 상태) 전이가 관측되지 않아 발화하지 않는다. -->
    <ControlTemplate x:Key="Spinner.Ring" TargetType="Control">
        <Ellipse x:Name="SpinnerRing"
                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="5"
                 StrokeDashArray="4 2" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard x:Name="SpinnerSpin">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:1"
                                         RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsVisible" Value="False">
                <Trigger.EnterActions>
                    <PauseStoryboard BeginStoryboardName="SpinnerSpin" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <ResumeStoryboard BeginStoryboardName="SpinnerSpin" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══════════════ ScreenTitle (화면 제목) ══════════════ -->
    <Style x:Key="ScreenTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H1}">
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <!-- ══════════════ 입력: TextBox (암묵 전역) ══════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Bg}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="MinHeight" Value="{StaticResource Touch.Min}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.S}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Disabled.Bg}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ 입력: PasswordBox (암묵 전역) ══════════════ -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Bg}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="MinHeight" Value="{StaticResource Touch.Min}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.S}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ 입력: ComboBox (암묵 전역, 라이트 ControlTemplate) ══════════════ -->
    <!-- ComboBoxItem: hover=Surface.Hover, 선택=Accent.Soft 배경 + Accent.Text (it3 §5.1) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: 닫힌 박스(Bg+Border+Radius.S+chevron), hover/focus 로즈, Popup+Shadow.Pop (it3 §5.1) -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Bg}" />
        <Setter Property="MinHeight" Value="{StaticResource Touch.Min}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- 클릭 영역 = 박스 전체(ToggleButton) -->
                        <ToggleButton x:Name="ToggleBox" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Brush.Bg}"
                                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.S}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 선택 값. ContentTemplate에 SelectionBoxItemTemplate 연결 —
                                                 DisplayMemberPath/ItemTemplate가 닫힌 박스에도 적용되도록(미설정 콤보는 null→ToString 폴백, 무영향). (it9 후속 버그수정) -->
                                            <ContentPresenter Grid.Column="0" Margin="12,0,0,0"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <!-- chevron ▾ -->
                                            <Path x:Name="Chevron" Grid.Column="1" Margin="8,0,14,0"
                                                  Width="12" Height="8" Stretch="Uniform"
                                                  Fill="{StaticResource Brush.Text.Tertiary}"
                                                  Data="M 0,0 L 6,6 L 12,0 Z" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 드롭다운 -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.S}"
                                    Effect="{StaticResource Shadow.Pop}" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="4" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- focus/open = 로즈 2px 보더(입력류 일관) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ToggleBox" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Disabled.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ 입력: CheckBox (암묵 전역) ══════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource Touch.Min}" />
    </Style>

    <!-- ══════════════ Toggle (ToggleButton 스위치) ══════════════ -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="{StaticResource Touch.Min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- 48px 히트영역, 시각 트랙 28px -->
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="52" Height="30"
                                CornerRadius="15"
                                Background="{StaticResource Brush.Surface.Alt}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" />
                        <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="{StaticResource Brush.Bg}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"
                                 Effect="{StaticResource Shadow.Sm}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Disabled.Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ ToggleButton.Segment (세그먼트 컨트롤 항목) ══════════════ -->
    <Style x:Key="Segment" TargetType="ToggleButton">
        <Setter Property="Height" Value="{StaticResource Touch.Min}" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.S}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Button.Shutter (원형 셔터, it3 §8) ══════════════ -->
    <!-- 이중 원: 바깥 흰 링 + 안쪽 로즈 원. press 시 안쪽 scale 0.9(눌림감). 촬영 다크 배경 전용. -->
    <Style x:Key="Button.Shutter" TargetType="Button">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- 바깥 흰 링 -->
                        <Ellipse Stroke="{StaticResource Brush.OnAccent}" StrokeThickness="4" Fill="Transparent" />
                        <!-- 안쪽 로즈 원 -->
                        <Ellipse x:Name="Inner" Margin="12" Fill="{StaticResource Brush.Accent}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="InnerScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Inner" Property="Fill" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Inner" Property="Fill" Value="{StaticResource Brush.Accent.Press}" />
                            <Setter TargetName="Inner" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
