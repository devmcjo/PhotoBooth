<Project Sdk="Microsoft.NET.Sdk">

  <!-- it23: Nikon MAID 외부 카메라 어댑터. (설계 §3.1)
       ⚠️ 이 프로젝트가 별도 어셈블리인 이유는 **SDK 참조를 격리**하기 위해서다:
          - MCPhoto.Capture는 OpenCvSharp(웹캠) 전담이다. 여기에 SDK 관리 DLL 참조가 생기면
            그 어셈블리 전체가 SDK 유무에 인질로 잡힌다.
          - 라이선스 문제(설계 §13 L1~L3)로 SDK 동봉이 불가해지면 이 프로젝트만 솔루션에서 빼고
            App의 DI 등록 한 줄을 NullExternalCamera로 되돌리면 된다.
       ⚠️ 의존성 규약(설계 §16 Step 5 완료 기준): OpenCvSharp·WPF·SDK를 참조하지 않는다.
          이미지 처리는 MCPhoto.Capture, UI는 App의 몫이고 이 프로젝트는 bytes만 다룬다.
          (이 규약은 NikonProjectBoundaryTests가 csproj 텍스트로 고정한다.) -->
  <PropertyGroup>
    <!-- 장치 드라이버 계층이라 Windows 전용이 명시적이다(향후 SDK 참조·P/Invoke 대비).
         UseWPF는 켜지 않는다 — UI 타입 무의존. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MCPhoto.Devices.Nikon</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCPhoto.Core\MCPhoto.Core.csproj" />
  </ItemGroup>

</Project>
