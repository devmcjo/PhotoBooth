# === MC포토 .gitignore (WBS Step 1) ===

# 빌드 산출물
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
*.dll
*.exe
*.pdb

# .NET / Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
_ReSharper*/
*.DotSettings.user

# NuGet
*.nupkg
packages/
.nuget/

# 테스트 결과
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml

# === 보안: 서비스 계정 키 절대 커밋 금지 (architecture §6.4) ===
*serviceaccount*.json
*service-account*.json
*firebase*credentials*.json
*firebase-adminsdk*.json
serviceAccountKey.json
google-services.json
*.pem
*.key

# 백엔드 게이트 키(publish 주입용 로컬 파일) — 커밋 금지
backend-apikey.local

# ffmpeg 바이너리 (라이선스·용량, 인스톨러가 별도 번들)
tools/ffmpeg/*.exe
tools/ffmpeg/*.dll

# 로컬 런타임 데이터
result/
*.log
*.ini
!appsettings.ini.sample

# 수동 테스트용 스크래치 이미지(프레임·스크린샷 등, 재생성 가능)
TEMP/

# publish 산출물(인스톨러 소스, 재생성 가능)
publish/
installer/Output/

# 웹 클라이언트 빌드 산출물(webclient → Hosting kiosk 사이트, docs/web-client/01 §5.2)
web/kiosk/
webclient/node_modules/
webclient/coverage/

# OS
Thumbs.db
Desktop.ini
.DS_Store
